DefineAICondTree()
{
  ; state 1, easy ai to start
  ; harrass the player's base a bit
  DefineCondState()
  {
    
   
    	DefineCondition(13 0 0 0 no_aip)
    	{  
    	CritTimer(6000)
    	}
    		
    	DefineCondition(3 0 0 0 convoy_moves)
    	{
    	CritTeamInRegion(80188 0)
    	}
    		
    	DefineCondition(4 0 0 0 fallback)
    	{  
    	CritEnemyInRegion(79263)
    	}
   
        DefineCondition(10 0 0 0 hard)
    	{  
    	CritDestroyBuilding()
    	{
	79025
 	}
 	}

SetAlliance(0 2 2 2 2 2 1 1)
SetAIPFile(EZ.aip)

  }


; state 2, where we'll be for most the time
; harrass the player's base a bit more
  
  DefineCondState()
  {
    
        DefineCondition(5 0 0 0 no_aip)
    	{
      	CritTimer(2500)
    	}	
 
   	DefineCondition(3 0 0 0 convoy_moves)
    	{
	CritTeamInRegion(80188 0)
    	}

    	DefineCondition(4 0 0 0 fallback)
    	{  
    	CritEnemyInRegion(79263)
    	}
 
	DefineCondition(10 0 0 0 hard)
    	{  
    	CritDestroyBuilding()
    	{
	79025
 	}
 	}

SetAIPFile(harass.aip)
AdjustRegionPri(80741 0 0 0)
AdjustRegionPri(14744 0 0 0)  ; left exit
AdjustRegionPri(24279 0 0 0)  ; right exit	

}


; state 3, the convoy has been released, so freak out
; we never leave this state
 
    DefineCondState()
    {
 
    	DefineCondition(3 0 0 0 go_go_go)
    	{
      	CritTimer(1000000)
    	}
    

    SetAIPFile(freak.aip)
    AdjustRegionPri(14744 20000 100 10000)  ; left exit
    AdjustRegionPri(24279 20000 100 10000)  ; right exit
}


