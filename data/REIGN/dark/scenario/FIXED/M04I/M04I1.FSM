	{
	CritNOT()
		{
		CritTeamInRegion(30558 0)
		}
	CritTeamInRegion(30559 0)
	}
	}

	DefineCondition(8 0 0 0 upper_gone_protect_lower_bridge)
	{
        CritAND()
	{
	CritDestroyBuilding()
		{
		33440
		}
	CritTeamInRegion(30559 0)
	}
	}

	DefineCondition(9 0 0 0 lower_gone_protect_upper_bridge)
	{
        CritAND()
	{
	CritDestroyBuilding()
		{
		33436
		}
	CritTeamInRegion(30558 0)
	}
	}

