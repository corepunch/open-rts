   "IMPStrikeMarine",          "FGMediumTank",		.25;
   "IMPFireSupportMarine",     "FGMediumTank",		.25;
   "IMPScoutTank",             "FGSpiderBike",		.25;           
   "IMPPlasmaTank",            "FGMercenary",		.25;          
    "IMPShredder",            "FGMediumTank",		.5;   
   
