DefineEndCondTree( 0 )
{
  ; State 1 this state waits for the player to get to the 2nd guard tower 
  DefineCondState()
  {
    DefineCondition( 2 0 0 0 "state_2"  )
    {
      CritMoveUnitsToRegion( 3077 3 )
      {
        2968 
        2966 
        2964 
        ;; Unit_ID
      }
      ;; Criteria
    }
    ;; State_Actions
  }

  ; State 2 this state makes team 4 ally with the player 
  DefineCondState()
  {
    SetAlliance( 2 1 1 1 2 1 1 1 )
    ;; State_Actions
  }

  ;; State
}
