      {
        CritBuildUnit( IMPScoutTank 1 )
        CritBuildUnit( IMPGroundTransporter 1 )
        ;; Criteria
      }
      ;; Criteria
    }
    TriggerMessage( State_B  )
    ;; State_Actions
  }

  ; State 6 this state gives the player 3 units and tells them to head north 
