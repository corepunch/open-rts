        ;; Criteria
      }
      ;; Criteria
    }
    ; this detects for a transition to the warning state 
    DefineCondition( 25 0 0 0 "warning"  )
    {
      CritTimer( 800 )
      ;; Criteria
    }
    ; this detects for a transition to the lose state 
    DefineCondition( 20 0 0 0 "you_lose"  )
    {
