/*******************************************************************************

  Default.AIP

 *****************************************************************************/

#include "aipdef.h"

// How often do we recompute the strategy?
int recompute_strategy_period = 50;


int infiltrator_period = 40;

// PRIORITIES
int ground_unit_threat = 10;             // Defense only!!!!!
int threat_priority = 10;                // Defense only!!!!!
int distance_priority = -20;
int defend_buildings_priority = 2000;
int attack_enemy_base_priority = 10;
int persistence_priority = 30;
int exploration_priority = 20;
int scripted_priority = 2000;
int single_use_group_priority = 30;
int perimeter_priority = 50;
int resource_priority = 15;             // Priority assigned to a cell with resources in it
int danger_priority = 1000;               // How does a cell's death differential affect us?
int danger_diminishment = 1;            // By how much can we reduce the danger of a cell

// TROOP COMMITMENT STUFF 
double min_matching_force_ratio = 2.1;
double max_matching_force_ratio = 6.4;

// When generic troops are called for, what should be ratio of troops that can
// shoot ground targets to troops that can shoot air targets?
double generic_ground_ratio = 1.0;

int min_building_defense_force = 0;
int max_building_defense_force = 70;

int min_exploration_force = 75;
int max_exploration_force = 225;

int min_perimeter_force = 20;
int max_perimeter_force = 70;

int min_resource_force = 0;           // Min & max troops for resource protection
int max_resource_force = 140;

// RELAXATION STUFF 
int relaxation_cycles = 1;
float relaxation_coefficient = .1;

// The transport we should use
#define transport "FGGroundTransporter"

// Should we repair buildings during this aip
int repair_buildings = 1;


///////////////////////////////////////////////////////////////////////////////
// New Construction Program stuff


///////////////////////////////////////////////////////////////////////////////
// The UCP Data
// --------------------
// This specifies what type of units to build.
UNIT_CONSTRUCTION_PROGRAM unit_construction_program[MAX_UCP_LENGTH];

#DATA

//   Which Account          BUDGET          BUDGET CAP
//----------------------------------------------------
     "Slush_fund",          UNLIMITED,      UNLIMITED;
     "Base_building",       30,             9500;
     "Offensive",           70,             15500;


#END_DATA



///////////////////////////////////////////////////////////////////////////////
// ACCOUNT NOTES.
// --------------
// For each line item in an account, you must specify a build type from one of
// the following... NUMBER_TO_HAVE, NUMBER_TO_BUILD, RATIO_TO_BUILD, or RATIO_TO_HAVE.
//
// The "RATIO" items can only occur in the lowest priority level of an account.
// Also, all line-items with the same priority must have the same build type


///////////////////////////////////////////////////////////////////////////////
// Slush_fund
// --------------------
// This specifies the baseline super-critical account

ACCOUNT Slush_fund[MAX_ACCOUNT_LENGTH];

#DATA

//  Priority     Item Name              Build Type              Build Amount
//--------------------------------------------------------------------
	19,		"fh1", 		         NUMBER_TO_HAVE,	1;
  	19,		"FGConstructionCrew", 	 NUMBER_TO_HAVE,	1;

#END_DATA



///////////////////////////////////////////////////////////////////////////////
// BASE_BUILDING
// --------------------
// How do we want to go about building our base?

ACCOUNT Base_building[MAX_ACCOUNT_LENGTH];

#DATA

//  Priority     Item Name              Build Type              Build Amount
//--------------------------------------------------------------------
	17,             "fglp",                 NUMBER_TO_HAVE,         1;
	17,             "fu1",                  NUMBER_TO_HAVE,         1;
	16,             "fc1",                  NUMBER_TO_HAVE,         1;		
	14,             "fgho",                 NUMBER_TO_HAVE,         1;
	13,             "fgre",                 NUMBER_TO_HAVE,         1;
	13,		"fgpp",			NUMBER_TO_HAVE,		2;
	12,             "fg",                   NUMBER_TO_HAVE,         2;
	10,		"fgpp",			NUMBER_TO_HAVE,		2;
	 8,             "fg",                   NUMBER_TO_HAVE,         4;
	


#END_DATA



///////////////////////////////////////////////////////////////////////////////
// OFFENSIVE
// --------------------
// What sort of offensive units and support structures do we want

ACCOUNT Offensive[MAX_ACCOUNT_LENGTH];

#DATA

//  Priority     Item Name              Build Type              Build Amount
//--------------------------------------------------------------------
		6,		 "FGFreedomFighter",		NUMBER_TO_HAVE,    25;
		5,		 "FGSpiderBike",	   	RATIO_TO_BUILD,	   200;
		5,		 "FGFreedomFighter",	   	RATIO_TO_BUILD,	   200;
		5,		 "FGMercenary",		   	RATIO_TO_BUILD,    150;
		5,		 "FGMediumTank",           	RATIO_TO_BUILD,    300;
		5,		 "FGTripleRailHoverTank",       RATIO_TO_BUILD,    100;
		5,		 "FGShockWave",      		RATIO_TO_BUILD,      1;

#END_DATA




///////////////////////////////////////////////////////////////////////////////
// FORCE MATCHING
// --------------
// Which units do we want to emphasize & target with this aip?
// Note that this can be used for BOTH the AI team's unit strengths and 
// the opponents'
FORCE_MATCHING My_Matchings[MAX_FORCE_MATCHING];

#DATA

// Unit Name             Multiplier
//----------------------------------
   "FGMercenary",        1.0;
   "FGSpiderBike",       1.0;

#END_DATA



///////////////////////////////////////////////////////////////////////////////
// Unit Match-ups
// --------------
// When we see a unit of one of the following types, build the corresponding 
// unit in the corresponding quantity
UNIT_MATCH_UP My_Match_ups[MAX_BUILDINGS];

#DATA

// Enemy Unit           What to build           How many to build
//------------------------------------------------------------------
   "ImpVTOL",        "FGConstructionMAD",          2.0;
   "IMPSkyFortress", "FGConstructionMAD",          2.0;
   "IMPReconSaucer", "FGMediumTank",               2.0;

#END_DATA
