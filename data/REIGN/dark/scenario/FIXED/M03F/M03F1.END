  {
    
    DefineCondition(1 0 0 0 "D") ; this is to change #6 alliance while running back to base
    {
	CritTimer(0)
    }
  
SetAlliance(0 2 1 1 1 0 1 1)

}

  ;
  ; Conditional State #5
