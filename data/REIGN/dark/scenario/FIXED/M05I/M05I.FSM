  }

; state 9
; middle right well approached. release defenders
  DefineCondState()
  {
    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)	
    }

    ReleaseSpecialForces(206)  
  }

; state 10
; middle right launch pad approached. release defenders
  DefineCondState()
  {
    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)
    }

    ReleaseSpecialForces(207) 
  }

; state 11
; top right well approached. release defenders
  DefineCondState()
  {

    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)	
    }

    ReleaseSpecialForces(208) 
  }

; state 12
; right base approached. release defenders
  DefineCondState()
  {
    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)	 
    }

    ReleaseSpecialForces(209) 
  }

; state 13
; middle base approached. release defenders
  DefineCondState()
  {
    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)	
    }

    ReleaseSpecialForces(210)  
  }

; state 14
; left base approached. release defenders
  DefineCondState()
  {
    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)	 
    }

    ReleaseSpecialForces(211)  
  }

;State 15
;
  DefineCondState()
  {
    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)	 
    }

    SetAIPFile(m05Id.aip)
  }

;State 16
;
  DefineCondState()
  {
    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)	 
    }

    SetAIPFile(m05I.aip)
  }

;State 17
;
  DefineCondState()
  {
    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)	 
    }

    SetAIPFile(m05Id.aip)
  }

;State 18
;
  DefineCondState()
  {  
    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)	 
    }

    SetAIPFile(m05I.aip)
  }

;State 19
;ally with building. AI attacks building. release 
;all special forces
  DefineCondState()
  {
    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)	 
    }

    BonusCredits(6 50000)
    SetAlliance(0 2 0 0 0 0 0 0)
    ReleaseSpecialForces(211)
    ReleaseSpecialForces(210)
    ReleaseSpecialForces(209)
    ReleaseSpecialForces(208)
    ReleaseSpecialForces(207)
    ReleaseSpecialForces(206)
    ReleaseSpecialForces(205)
    ReleaseSpecialForces(204)
    ReleaseSpecialForces(203)
    ReleaseSpecialForces(202)
    ReleaseSpecialForces(201)
    ReleaseSpecialForces(200)
  }


;State 20
;ally with building. AI attacks building.
  DefineCondState()
  {
    DefineCondition(2 0 0 0 back_to_base_state)
    {
      CritTimer(0)	 
    }

    BonusCredits(6 50000)
    SetAlliance(0 2 0 0 0 0 0 0)
  }
}
