  "FGFreedomFighter",          "IMPShredder",		.15;
   "FGMercenary",     		"IMPShredder",		.15;
   "FGSpiderBike",             	"IMPScoutTank",		.5;           
   "FGMediumTank",            "IMPPlasmaTank",		.2;          
   "FGTankHunterTank",	      "IMPStrikeMarine",	5;	  
