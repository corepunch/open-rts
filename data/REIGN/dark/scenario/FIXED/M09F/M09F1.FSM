;
; AI Conditional FSM for team 1
;
DefineAICondTree()
{
;
; Conditional State #1 EZ  STATE
;
DefineCondState()
{
    	
 	
	DefineCondition(2 0 0 0 base) 
	{
	CritONCE()
	{
	CritHaveCredits(50000)
	}
	}


	
     	
	DefineCondition(3 0 0 0 "defend")  ;   base under attack
    	{					  
       	CritTeamInRegion(37993 0)
       	}
     
	DefineCondition(4 0 0 0 "air_attack")  ; protect dr. moebeus
    	{					
   	CritTeamInRegion(37992 0)
    	}
     
	DefineCondition(5 0 0 0 "kill")  ; kill kill kill
    	{
       	CritNOT()
       	{
	CritTeamInRegion(37992 2)
	}
    	}

 	DefineCondition(6 0 0 0 "attack") ; destroy guard towers
     	{
   	CritAND()
	{
	CritDestroyBuilding()
		{
		41553 46676 49107
		}
	CritTimer(22000)
	CritEnemyInRegion(37688)
	}
	}

	DefineCondition(7 0 0 0 "attack") ; destroy guard towers
	{	
   	CritAND()
	{
	CritDestroyBuilding()
		{
		45273 46679 49110
		}
   	CritTimer(22000)
	CritEnemyInRegion(37687)
	}
	}

	DefineCondition(8 0 0 0 harass_upper_water) ; upper focus
  	{
	CritAND()
	{
	CritEnemyInRegion(37688)
	CritNOT()
		{
		CritEnemyInRegion(37687)
		}
	CritTimer(3000)
	}
	}
	
	DefineCondition(9 0 0 0 harass_lower_water) 
  	{
	CritAND()
	{
	CritEnemyInRegion(37687)
	CritNOT()
		{
		CritEnemyInRegion(37688)
		}
	CritTimer(3000)
	}
	}

	DefineCondition(10 0 0 0 harass_both_waters) 
 	{
	CritAND()
	{
	CritEnemyInRegion(37688)
	CritEnemyInRegion(37687)
	CritTimer(3000)
	}
	}
	
	DefineCondition(11 0 0 0 attack_both_waters) 
 	{
	CritAND()
	{	
	CritDestroyBuilding()
		{
		
		45273 46679 49110
		}
   	CritDestroyBuilding()
		{
		41553 46676 49107
		}
	CritTimer(3000)
	}
	}

	DefineCondition(12 0 0 0 base) 
 	{
	CritAND()
	{	
	CritDestroyBuilding()
		{
		45273 46679 49110
		}
   	CritDestroyBuilding()
		{
		41553 46676 49107
		}
	CritTimer(3000)
	CritNOT()
		{
		CritEnemyInRegion(37688)
		}
	CritNOT()
		{
		CritEnemyInRegion(37687)
		}
	}
	}


	AdjustRegionPri(37687 0 0 0)
	AdjustRegionPri(37688 0 0 0)
	AdjustRegionPri(37992 0 0 0)
	SetAlliance(0 2 1 1 1 1 1 2)
    	SetAIPFile(ez.aip)  

}


