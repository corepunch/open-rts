//
// commnFSM.saf
//
// SafeEdit text editor configuration for Dark Reign FSMs.
//
// This file configures the safeedit system to allow the syntax safe editing
// of Finite State Machines & Endcondition Trees for the Dark Reign System

// How much should we indent?
#define INDENTATION 2

///////////////////////////////////////////////////////////////////////////////
// The Safe Syntax Elements
// --------------------
// This specifies all user-defined elements for this syntax safe editor
SAFE_ELEMENTS_NAME_LIST user_elements[MAX_SAFE_ELEMENTS];

#DATA

//   Element Name
//----------------------------------------------------
  "DefineAICondTree";
  "DefineEndCondTree";
  "DefineCondState";
  "SetAlliance";
  "State_Actions";
  "TriggerSpecialForces";
  "ReleaseSpecialForces";
  "GiveSpecialForces";
  "Comment";
  "AdjustRegionPri";
  "SetAIPFile";
  "SetMessageFile";
  "DefineCondition";
  "BonusCredits";
  "TriggerMessage";
  "Simple_Int";
  "Criteria";
  "CritOR";
  "CritAND";
  "CritNOT";
  "CritONCE";
  "CritMoreUnitsThanEnemy";
  "CritLessUnitsThanEnemy";
  "CritTimer";
  "CritTimerGame";
  "CritStealPlan";
  "CritHoldRegion";
  "CritHarassRegion";
  "CritBuildBuilding";
  "CritBeginBuildBuilding";
  "CritBuildUnit";
  "CritMoveUnitsToRegion";
  "CritDestroyBuilding";
  "CritDestroyThing";
  "CritDestroyUnit";
  "CritCollectMineral";
  "CritCollectWater";
  "CritKillEnemyUnits";
  "CritKillTeamUnits";
  "CritDestroyEnemyBuildings";
  "CritDestroyTeamBuildings";
  "CritKillAll";
  "CritKillAllAndAllies";
  "CritDestroyBuildingType";
  "CritKillUnitType";
  "CritEnemyInRegion";
  "CritInRegion";
  "CritTeamInRegion";
  "CritHaveCredits";

#END_DATA


///////////////////////////////////////////////////////////////////////////////
// Add Anywhere Elements
// ---------------------
// This specifies elements (such as comments) which can be added anywhere into
// the safe document
SAFE_ELEMENTS_NAME_LIST add_anywhere_elements[MAX_SAFE_ELEMENTS];

#DATA

//   Element Name
//----------------------------------------------------
	 "Comment";

#END_DATA




///////////////////////////////////////////////////////////////////////////////
//
// Comment
// --------------------
//
// An FSM comment.
//
SAFE_ELEMENT Comment[MAX_SAFE_SUBELEMENTS];

#DATA
// Element Text/Name      Type            MIN/MAX        Lower Bound        Upper Bound      Separator  Indent?
"", "; ",                 "SAFE_TEXT",    NA, NA,        UNBOUNDED, NA,     UNBOUNDED, NA,   "",        INDENT, 0, "";
"", "Comment",            "STRING",       NA, NA,        UNBOUNDED, NA,     UNBOUNDED, NA,   " ",       DONT_INDENT, 0,
" 
";
"", "",                  "SAFE_TEXT",    NA, NA,        UNBOUNDED, NA,     UNBOUNDED, NA,   
"
", DONT_INDENT, 0, "";


#END_DATA





///////////////////////////////////////////////////////////////////////////////
//
// DefineEndCondTree
// --------------------
//
// The root of an endcondition
//
SAFE_ELEMENT DefineEndCondTree[MAX_SAFE_SUBELEMENTS];

#DATA
// Element Text/Name               Type                MIN/MAX        Lower Bound        Upper Bound      Separator
"", "DefineEndCondTree( ",          "SAFE_TEXT",        NA, NA,        UNBOUNDED, NA,     UNBOUNDED, NA,   
"", INDENT, 0, "";

"", "Time_Limit",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, " ";

"", ")
{",                                "SAFE_TEXT",        NA, NA,        UNBOUNDED, NA,     UNBOUNDED, NA,   
"
", DONT_INDENT, 0, "";

";; ", "State",                     "DefineCondState",  0, UNLIMITED,  BOUNDED,   1,      UNBOUNDED, NA,   
"
", INDENT, 1, "";

"", "}
",                                 "SAFE_TEXT",        NA, NA,        UNBOUNDED, NA,     UNBOUNDED, NA,   
"", INDENT, 0, "";
#END_DATA




///////////////////////////////////////////////////////////////////////////////
//
// DefineAICondTree
// --------------------
//
// The root of an AI FSM.
//
SAFE_ELEMENT DefineAICondTree[MAX_SAFE_SUBELEMENTS];

#DATA
// Element Text/Name               Type                MIN/MAX        Lower Bound        Upper Bound      Separator
"", "DefineAICondTree()
{",                                "SAFE_TEXT",        NA, NA,        UNBOUNDED, NA,     UNBOUNDED, NA,   
"
", INDENT, 0, "";

";; ", "State",                     "DefineCondState",  0, UNLIMITED,  BOUNDED,   1,      UNBOUNDED, NA,   
"
", INDENT, 1, "";

"", "}
",                                 "SAFE_TEXT",        NA, NA,        UNBOUNDED, NA,     UNBOUNDED, NA,   
"", INDENT, 0, "";
#END_DATA








///////////////////////////////////////////////////////////////////////////////
//
// DefineCondState
// --------------------
//
// A single State in an FSM.
//
SAFE_ELEMENT DefineCondState[MAX_SAFE_SUBELEMENTS];

#DATA
// Element Text/Name                 Type                MIN/MAX          Lower Bound        Upper Bound      Separator
"", "DefineCondState()",			 "SAFE_TEXT",        NA, NA,          UNBOUNDED, NA,     UNBOUNDED, NA,   
"
", INDENT, 0, "";

"", "{",							 "SAFE_TEXT",        NA, NA,          UNBOUNDED, NA,     UNBOUNDED, NA,   
"
", INDENT, 0, "";

";; ", "State_Actions",               "OPTION_LIST",      0, UNLIMITED,    BOUNDED,   1,      UNBOUNDED, NA,   
"
", INDENT, 1, "";

"", "}
",									 "SAFE_TEXT",        NA, NA,          UNBOUNDED, NA,     UNBOUNDED, NA,   
"
", INDENT, 0, "";
#END_DATA


///////////////////////////////////////////////////////////////////////////////
//
// State_Actions
// --------------------
//
// An OPTION LIST of actions available in an FSM state.
//
SAFE_ELEMENT State_Actions[MAX_SAFE_SUBELEMENTS];

#DATA
// Element Text/Name              Type                       MIN/MAX           Lower Bound        Upper Bound      Separator
"", "Alliances",                  "SetAlliance",              0, 1,             BOUNDED,   1,      UNBOUNDED, NA,   ""       DONT_INDENT, 0, "";
"", "Trigger Special Forces",     "TriggerSpecialForces",     0, 1,             BOUNDED,   1,      UNBOUNDED, NA,   ""       DONT_INDENT, 0, "";
"", "Release Special Forces",     "ReleaseSpecialForces",     0, 1,             BOUNDED,   1,      UNBOUNDED, NA,   ""       DONT_INDENT, 0, "";
"", "Give Special Forces",        "GiveSpecialForces",        0, 1,             BOUNDED,   1,      UNBOUNDED, NA,   ""       DONT_INDENT, 0, "";
"", "Adjust Region Priorities",   "AdjustRegionPri",          0, 1,             BOUNDED,   1,      UNBOUNDED, NA,   ""       DONT_INDENT, 0, "";
"", "Set AIP File",               "SetAIPFile",               0, 1,             BOUNDED,   1,      UNBOUNDED, NA,   ""       DONT_INDENT, 0, "";
"", "Set Message File",           "SetMessageFile",           0, 1,             BOUNDED,   1,      UNBOUNDED, NA,   ""       DONT_INDENT, 0, "";
"", "Bonus Credits",              "BonusCredits",             0, 1,             BOUNDED,   1,      UNBOUNDED, NA,   ""       DONT_INDENT, 0, "";
"", "Trigger Message",            "TriggerMessage",           0, 1,             BOUNDED,   1,      UNBOUNDED, NA,   ""       DONT_INDENT, 0, "";
"", "Define Condition",           "DefineCondition",          0, 1,             BOUNDED,   1,      UNBOUNDED, NA,   ""       DONT_INDENT, 0, "";
#END_DATA


///////////////////////////////////////////////////////////////////////////////
//
// SetAlliance
// --------------------
//
// Set the alliances for a team.
//
SAFE_ELEMENT SetAlliance[MAX_SAFE_SUBELEMENTS];

#DATA
// Element Text/Name           Type              MIN/MAX              Lower Bound        Upper Bound      Separator  Indentation?
"", "SetAlliance(",            "SAFE_TEXT",      NA, NA,              UNBOUNDED, NA,     UNBOUNDED, NA,   " ",       INDENT, 0, "";
"", "Team0",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, " ";
"", "Team1",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, " ";
"", "Team2",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, " ";
"", "Team3",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, " ";
"", "Team4",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, " ";
"", "Team5",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, " ";
"", "Team6",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, " ";
"", "Team7",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, " ";
//"", "Team8",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, " ";
"", ")",                       "SAFE_TEXT",      NA, NA,              UNBOUNDED, NA,     UNBOUNDED, NA,   "
",       DONT_INDENT, 0, "";
#END_DATA



