"", "Region_ID",                    "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, "";
"", "Priority",                     "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, "";
"", "Min_Forces",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, "";
"", "Max_Forces",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, "";
"", ")",                            "SAFE_TEXT",      NA, NA,              UNBOUNDED, NA,     UNBOUNDED, NA,   "
",       DONT_INDENT, 0, "";
#END_DATA


