///////////////////////////////////////////////////////////////////////////////
//
// DefineCondition
// --------------------
//
// Define a condition for going from one state to another.
//
SAFE_ELEMENT DefineCondition[MAX_SAFE_SUBELEMENTS];

#DATA
// Element Text/Name                Type              MIN/MAX              Lower Bound        Upper Bound      Separator  Indentation?
"", "DefineCondition(",             "SAFE_TEXT",      NA, NA,              UNBOUNDED, NA,     UNBOUNDED, NA,   " ",       INDENT, 0, "";
"", "Next_State",                   "INTEGER",        1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, "";
"", "0",                            "SAFE_TEXT",      1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, "";
"", "0",                            "SAFE_TEXT",      1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, "";
"", "0",                            "SAFE_TEXT",      1, 1,                BOUNDED, 0,        BOUNDED,    2,   " ",       DONT_INDENT, 0, "";
"", "FileName",                     "STRING",         NA, NA,              UNBOUNDED, NA,     UNBOUNDED, NA,   " ",       DONT_INDENT, 0,
")";
"", ")",                            "SAFE_TEXT",      NA, NA,              UNBOUNDED, NA,     UNBOUNDED, NA,   "
",       DONT_INDENT, 0, "";
"", "{",             "SAFE_TEXT",      NA, NA,              UNBOUNDED, NA,     UNBOUNDED, NA,   "
",       INDENT, 0, "";
";; ", "Criteria",               "OPTION_LIST",      0, UNLIMITED,    BOUNDED,   1,      UNBOUNDED, NA,   
"
", INDENT, 1, "";

"", "}",             "SAFE_TEXT",      NA, NA,              UNBOUNDED, NA,     UNBOUNDED, NA,   "
",       INDENT, 0, "";
#END_DATA



