<?xml version="1.0" encoding="UTF-8"?>
<!-- Rustfront kit: the small mechanical parts of the vehicles and yards, then the big painted
     forms of the buildings (chunk, emblem, collar, stack, beacon). Include it beside
     utilities.xml in a prefab; every call takes pos/rot like a shape. -->
<library>
  <define name="ladder" doc="A wall ladder rising along Y from pos, rungs along X, standing proud of the wall by its pos.">
    <param name="height"/>
    <group>
      <box size="2 ${height} 2" pos="-8 {${height}/2} 0" material="steel_dark"/>
      <box size="2 ${height} 2" pos="8 {${height}/2} 0" material="steel_dark"/>
      <box size="16 1.5 1.5" pos="0 6 0" material="steel"><array count="{floor((${height})/12)}" translation="0 12 0"/></box>
    </group>
  </define>

  <define name="vent" doc="A rooftop air handler: a gunmetal box with a louvred top and a fan ring. Base on pos.">
    <param name="width" default="40"/><param name="depth" default="40"/><param name="height" default="20"/>
    <group>
      <box size="${width} ${height} ${depth}" pos="0 {${height}/2} 0" material="gunmetal"/>
      <box size="{${width}-6} 2 3" pos="0 {${height}+1} {-(${depth})/2+6}" material="steel_dark">
        <array count="{floor(((${depth})-8)/7)}" translation="0 0 7"/>
      </box>
    </group>
  </define>

  <define name="warn-light" doc="A warning lamp on a short stalk; base on pos. on=&quot;{blink}&quot; makes it blink with a prefab's blink knob: lit while on is 1, a dark lens otherwise.">
    <param name="material" default="warn"/>
    <param name="on" default="1"/>
    <group>
      <cylinder radius="1.5" height="6" sides="6" pos="0 3 0" material="steel_dark"/>
      <sphere radius="3.2" rings="6" slices="8" pos="0 8 0" material="lens_off"/>
      <sphere radius="6.5" rings="6" slices="8" pos="0 8 0" material="${material}" unlit="1" castShadow="0" renderable="${on}"/>
    </group>
  </define>

  <define name="muzzle-flash" doc="A gun's flash, pointing along +X from pos (the muzzle); about 60 cm long at scale 1, so scale the call. on=&quot;{fire == 1}&quot; shows it only on a prefab's firing frame.">
    <param name="on" default="1"/>
    <group>
      <cone radius="10" radiusTop="0" height="46" sides="8" rot="0 0 -90" pos="23 0 0" material="flash" unlit="1" castShadow="0" renderable="${on}"/>
      <cone radius="5" radiusTop="0" height="62" sides="6" rot="0 0 -90" pos="31 0 0" material="flash_core" unlit="1" castShadow="0" renderable="${on}"/>
      <sphere radius="10" rings="4" slices="8" scale="0.45 1.7 1.7" pos="3 0 0" material="flash" unlit="1" castShadow="0" renderable="${on}"/>
      <sphere radius="6" rings="4" slices="6" pos="4 0 0" material="flash_core" unlit="1" castShadow="0" renderable="${on}"/>
    </group>
  </define>

  <define name="sandbags" doc="A short sandbag wall along local X, two courses. Base on pos.">
    <param name="count" default="3"/>
    <group>
      <capsule radius="9" height="18" rings="3" slices="8" rot="0 0 90" pos="{-((${count})-1)*20} 9 0" material="sandbag">
        <array count="${count}" translation="0 -40 0"/>
      </capsule>
      <capsule radius="9" height="18" rings="3" slices="8" rot="0 0 90" pos="{-((${count})-1)*20+20} 25 0" material="sandbag">
        <array count="{(${count})-1}" translation="0 -40 0"/>
      </capsule>
    </group>
  </define>

  <!-- The big painted forms of the buildings. -->
  <define name="chunk" doc="A chunky hull: a rounded-rectangle plan raised along Y, with chamfered rims and walls that lean in. Centred on pos, like a box; width and depth are the base's.">
    <param name="width"  doc="x size at the base, cm"/>
    <param name="height" doc="y size, cm"/>
    <param name="depth"  doc="z size at the base, cm"/>
    <param name="radius" default="30" doc="plan corner radius, cm"/>
    <param name="bevel"  default="10" doc="rim chamfer, cm; below radius and half the height"/>
    <param name="lean"   default="0.08" doc="how much smaller the top is (0.08 = 8 %)"/>
    <param name="segments" default="4" doc="segments of each plan corner"/>
    <shape closed="0" rot="90 0 0" v="-{(${width})*(1-(${lean})/2)/2} -{(${depth})*(1-(${lean})/2)/2} {(${width})*(1-(${lean})/2)/2} -{(${depth})*(1-(${lean})/2)/2}">
      <shell amount="{(${depth})*(1-(${lean})/2)}"/><fillet radius="${radius}" segments="${segments}"/>
      <extrude amount="${height}"/><bevel amount="${bevel}" bevelSegments="2"/>
      <taper center="0 0 0" amount="{2*(${lean})/(2-(${lean}))}" axis="z"/>
    </shape>
  </define>

  <define name="emblem" doc="The faction roundel, lying flat with its top toward -Z: a gold cog, a dark field and a white double chevron. Base on pos; stand it on a wall with a group rot.">
    <param name="radius" default="60"/>
    <group>
      <star outerRadius="${radius}" innerRadius="{(${radius})*0.86}" points="14" rot="-90 0 0" pos="0 1.5 0" material="emblem_gold"><extrude amount="3"/></star>
      <cylinder radius="{(${radius})*0.76}" height="4" sides="28" pos="0 2 0" material="emblem_dark"/>
      <shape closed="1" rot="-90 0 0" pos="0 4.5 0" material="emblem_white"
             v="0 {(${radius})*0.60} {(${radius})*0.52} {(${radius})*0.12} {(${radius})*0.52} {-(${radius})*0.14} 0 {(${radius})*0.32} {-(${radius})*0.52} {-(${radius})*0.14} {-(${radius})*0.52} {(${radius})*0.12}">
        <extrude amount="2"/></shape>
      <shape closed="1" rot="-90 0 0" pos="0 4.5 0" material="emblem_gold"
             v="0 {(${radius})*0.16} {(${radius})*0.42} {-(${radius})*0.24} {(${radius})*0.42} {-(${radius})*0.48} 0 {-(${radius})*0.10} {-(${radius})*0.42} {-(${radius})*0.48} {-(${radius})*0.42} {-(${radius})*0.24}">
        <extrude amount="2"/></shape>
    </group>
  </define>

  <define name="collar" doc="A hazard-striped ring round a drum of this radius, stripes running round it. Centred on pos.">
    <param name="radius"/><param name="height" default="16"/>
    <param name="material" default="hazard_ring"/>
    <group>
      <surface segments="24 1" closed="u" material="${material}" x="(${radius})*cos(u*2*pi)" y="(${height})*(v-0.5)" z="-(${radius})*sin(u*2*pi)"/>
      <cylinder radius="{(${radius})-0.5}" height="{(${height})-0.5}" sides="24" material="emblem_gold"/>
    </group>
  </define>

  <define name="stack" doc="A stubby exhaust stack with a hazard collar and a dark mouth. Base on pos.">
    <param name="radius" default="22"/><param name="height" default="110"/>
    <group>
      <cylinder radius="${radius}" height="${height}" sides="16" pos="0 {(${height})/2} 0" material="trim_light"/>
      <collar radius="{(${radius})+3}" height="16" pos="0 {(${height})-18} 0"/>
      <cylinder radius="{(${radius})+2}" height="8" sides="16" pos="0 4 0" material="trim"/>
      <cylinder radius="{(${radius})-5}" height="2" sides="16" pos="0 {(${height})+0.5} 0" material="rubber"/>
    </group>
  </define>

  <define name="beacon" doc="A big warning beacon on a dark cap, for the tops of pylons. Base on pos. on=&quot;{blink}&quot; blinks it.">
    <param name="on" default="1"/>
    <group>
      <cylinder radius="9" height="6" sides="10" pos="0 3 0" material="trim"/>
      <sphere radius="7" rings="6" slices="10" pos="0 9 0" material="lens_off"/>
      <sphere radius="10" rings="6" slices="10" pos="0 9 0" material="warn" unlit="1" castShadow="0" renderable="${on}"/>
    </group>
  </define>
</library>
