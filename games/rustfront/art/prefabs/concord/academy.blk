<?xml version="1.0" encoding="UTF-8"?>
<!-- Lumen Concord Academy (barracks). Footprint 2x2 cells (400 x 400 cm), origin at pad centre on
     the ground, entrance faces +Z. A round ceramic hall under a pearl dome, with glowing slit
     windows and a team-colour band; a tall pointed portal at the front between two slender
     pylons carrying team banners; a lens on the dome's crown under a floating halo. About 300 cm
     tall. -->
<prefab up="y" front="+z">
  <include src="../../utilities.xml"/>
  <include src="../../kit.xml"/>
  <!-- Lumen Concord materials: identical in every concord prefab (ids are global, first wins). -->
  <material id="concord_ceramic"  color="0.88 0.91 0.95" shininess="55" specular="1" gradientFrom="0.72 0.74 0.80" gradientTo="1.04 1.04 1.04"/>
  <material id="concord_pearl"    color="0.68 0.71 0.75" shininess="45" specular="1" gradientFrom="0.80 0.80 0.84" gradientTo="1.04 1.04 1.04"/>
  <material id="concord_graphite" color="0.14 0.15 0.18" shininess="40" specular="1"/>
  <material id="concord_stone"    color="0.74 0.76 0.79" shininess="8"><map type="bricks" size="100 100 100" mortar="1.5" bond="0.5" vary="0.04" from="1 1 1" to="0.62 0.63 0.66"/></material>
  <material id="concord_crystal"  color="0.50 0.88 1.00" shininess="90" specular="1.5" gradientFrom="0.55 0.70 0.80" gradientTo="1.15 1.10 1.05"/>
  <material id="concord_core"     color="0.85 1.00 1.00"/>
  <!-- Animation knobs, set per frame by art/sprites.py: pulse 0/1 lifts the halo 6 cm and
       brightens the portal and the crown lens; spin 0..0.875 in 8 steps turns the halo's four
       vanes 11.25 degrees a step (fourfold, so the loop closes). -->
  <let name="pulse" value="0"/>
  <let name="spin" value="0"/>

  <shape id="concord_acad_hall" closed="0" v="128 0 128 8 120 16 116 70 120 76 120 84 112 92 108 110 100 140 82 168 56 188 26 198 0 201"/>
  <shape id="concord_acad_plinth" closed="0" v="150 0 150 8 144 14 132 16"/>

  <chunk width="392" height="20" depth="392" radius="36" bevel="3" lean="0" pos="0 10 0" material="concord_stone"/>

  <group rot="0 14 0" scale="1 1 1" pos="0 0 -14">
    <lathe shape="concord_acad_plinth" segments="36" pos="0 20 0" material="concord_pearl"/>
    <lathe shape="concord_acad_hall" segments="36" pos="0 36 0" material="concord_ceramic"/>
    <cylinder radius="117" height="14" tube="4" sides="36" pos="0 120 0" material="paint_plain" tint="1"/>
    <cylinder radius="121" height="4" sides="36" pos="0 114 0" material="concord_graphite"/>
    <group rot="0 60 0"><box size="14 44 6" pos="0 80 115" material="concord_graphite"/><box size="8 38 2" pos="0 80 118.5" material="glow" unlit="1" castShadow="0"/></group>
    <group rot="0 100 0"><box size="14 44 6" pos="0 80 115" material="concord_graphite"/><box size="8 38 2" pos="0 80 118.5" material="glow" unlit="1" castShadow="0"/></group>
    <group rot="0 140 0"><box size="14 44 6" pos="0 80 115" material="concord_graphite"/><box size="8 38 2" pos="0 80 118.5" material="glow" unlit="1" castShadow="0"/></group>
    <group rot="0 220 0"><box size="14 44 6" pos="0 80 115" material="concord_graphite"/><box size="8 38 2" pos="0 80 118.5" material="glow" unlit="1" castShadow="0"/></group>
    <group rot="0 260 0"><box size="14 44 6" pos="0 80 115" material="concord_graphite"/><box size="8 38 2" pos="0 80 118.5" material="glow" unlit="1" castShadow="0"/></group>
    <group rot="0 300 0"><box size="14 44 6" pos="0 80 115" material="concord_graphite"/><box size="8 38 2" pos="0 80 118.5" material="glow" unlit="1" castShadow="0"/></group>
    <!-- four team-colour ribs over the dome -->
    <group rot="0 45 0"><surface segments="12 1" twoSided="1" material="paint_plain" tint="1" x="(113+0*v)*cos(u*pi*0.47)" y="136+105*sin(u*pi*0.47)" z="(v-0.5)*18"/></group>
    <group rot="0 135 0"><surface segments="12 1" twoSided="1" material="paint_plain" tint="1" x="(113+0*v)*cos(u*pi*0.47)" y="136+105*sin(u*pi*0.47)" z="(v-0.5)*18"/></group>
    <group rot="0 225 0"><surface segments="12 1" twoSided="1" material="paint_plain" tint="1" x="(113+0*v)*cos(u*pi*0.47)" y="136+105*sin(u*pi*0.47)" z="(v-0.5)*18"/></group>
    <group rot="0 315 0"><surface segments="12 1" twoSided="1" material="paint_plain" tint="1" x="(113+0*v)*cos(u*pi*0.47)" y="136+105*sin(u*pi*0.47)" z="(v-0.5)*18"/></group>
    <torus majorRadius="140" minorRadius="3" majorSegments="40" minorSegments="6" pos="0 33 0" material="glow" unlit="1" castShadow="0"/>
    <!-- crown: a lens on the dome and a floating halo with four vanes -->
    <cylinder radius="30" height="8" sides="24" pos="0 234 0" material="concord_graphite"/>
    <sphere radius="20" rings="8" slices="16" pos="0 244 0" material="concord_crystal"/>
    <sphere radius="23" rings="8" slices="16" pos="0 244 0" material="concord_core" unlit="1" castShadow="0" renderable="{pulse}"/>
    <group pos="0 {286+pulse*6} 0" rot="0 {90*spin} 0">
      <torus majorRadius="58" minorRadius="6" majorSegments="32" minorSegments="8" material="concord_ceramic"/>
      <torus majorRadius="58" minorRadius="3.5" majorSegments="32" minorSegments="6" pos="0 -5 0" material="glow" unlit="1" castShadow="0"/>
      <box size="30 6 10" pos="68 0 0" material="paint_plain" tint="1"/>
      <box size="30 6 10" pos="-68 0 0" material="paint_plain" tint="1"/>
      <box size="10 6 30" pos="0 0 68" material="paint_plain" tint="1"/>
      <box size="10 6 30" pos="0 0 -68" material="paint_plain" tint="1"/>
    </group>

    <!-- portal: a tall pointed frame standing out of the wall at +Z -->
    <group pos="0 36 112">
      <shape closed="1" v="-46 0 46 0 46 104 0 168 -46 104" material="concord_ceramic"><extrude amount="44"/><bevel amount="5" bevelSegments="2"/></shape>
      <shape closed="1" v="-50 0 50 0 50 20 -50 20" pos="0 -6 4" material="paint_plain" tint="1"><extrude amount="46"/><bevel amount="3" bevelSegments="2"/></shape>
      <shape closed="1" v="-28 0 28 0 28 92 0 136 -28 92" pos="0 0 21" material="concord_graphite"><extrude amount="4"/></shape>
      <shape closed="1" v="-20 0 20 0 20 86 0 120 -20 86" pos="0 0 23.5" material="glow" unlit="1" castShadow="0"><extrude amount="2"/></shape>
      <shape closed="1" v="-10 0 10 0 10 80 0 100 -10 80" pos="0 0 25" material="concord_core" unlit="1" castShadow="0" renderable="{pulse}"><extrude amount="2"/></shape>
    </group>
    <box size="70 4 70" pos="0 22 170" material="concord_pearl"/>

    <!-- two pylons flanking the portal, with team banners -->
    <group pos="-96 20 150">
      <cylinder radius="18" height="10" sides="16" pos="0 5 0" material="concord_graphite"/>
      <cone radius="13" radiusTop="7" height="190" sides="12" pos="0 105 0" material="concord_ceramic"/>
      <cone radius="8" radiusTop="0" height="28" sides="6" smooth="0" pos="0 214 0" material="concord_crystal"/>
      <box size="4 92 30" pos="0 120 12" material="paint_plain" tint="1"/>
      <box size="32 6 34" pos="0 168 10" material="concord_ceramic"/>
    </group>
    <group pos="96 20 150">
      <cylinder radius="18" height="10" sides="16" pos="0 5 0" material="concord_graphite"/>
      <cone radius="13" radiusTop="7" height="190" sides="12" pos="0 105 0" material="concord_ceramic"/>
      <cone radius="8" radiusTop="0" height="28" sides="6" smooth="0" pos="0 214 0" material="concord_crystal"/>
      <box size="4 92 30" pos="0 120 12" material="paint_plain" tint="1"/>
      <box size="32 6 34" pos="0 168 10" material="concord_ceramic"/>
    </group>
  </group>
</prefab>
