<?xml version="1.0" encoding="UTF-8"?>
<!-- Lumen Concord Beam Tower, assembled: beam_tower/base plus beam_tower/head at (0, 140, 0)
     turned to face +Z. Footprint 1x1 cell (200 x 200 cm), origin at pad centre on the ground, the
     emitter faces +Z. -->
<prefab up="y" front="+z">
  <prefab source="concord/beam_tower/base"/>
  <prefab source="concord/beam_tower/head" pos="0 140 0" rot="0 -90 0"/>
</prefab>
