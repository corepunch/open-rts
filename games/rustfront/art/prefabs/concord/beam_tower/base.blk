<?xml version="1.0" encoding="UTF-8"?>
<!-- Lumen Concord Beam Tower base without its head (see beam_tower/head.blk). Footprint 1x1 cell
     (200 x 200 cm), origin at pad centre on the ground. A round stone pad; a slender flared
     ceramic pylon with three team-colour fins and cyan lines, ending in a graphite bearing ring at
     the head's mount height, 130 cm. -->
<prefab up="y" front="+z">
  <include src="../../../utilities.xml"/>
  <include src="../../../kit.xml"/>
  <!-- Lumen Concord materials: identical in every concord prefab (ids are global, first wins). -->
  <material id="concord_ceramic"  color="0.88 0.91 0.95" shininess="55" specular="1" gradientFrom="0.72 0.74 0.80" gradientTo="1.04 1.04 1.04"/>
  <material id="concord_pearl"    color="0.68 0.71 0.75" shininess="45" specular="1" gradientFrom="0.80 0.80 0.84" gradientTo="1.04 1.04 1.04"/>
  <material id="concord_graphite" color="0.14 0.15 0.18" shininess="40" specular="1"/>
  <material id="concord_stone"    color="0.74 0.76 0.79" shininess="8"><map type="bricks" size="100 100 100" mortar="1.5" bond="0.5" vary="0.04" from="1 1 1" to="0.62 0.63 0.66"/></material>
  <material id="concord_crystal"  color="0.50 0.88 1.00" shininess="90" specular="1.5" gradientFrom="0.55 0.70 0.80" gradientTo="1.15 1.10 1.05"/>
  <material id="concord_core"     color="0.85 1.00 1.00"/>
  <!-- Animation knob, set per frame by art/sprites.py: pulse 0/1 brightens the pylon's lines. -->
  <let name="pulse" value="0"/>

  <shape id="concord_bt_pylon" closed="0" v="70 0 70 6 62 12 44 26 32 50 28 80 32 98 42 108 46 114"/>

  <chunk width="192" height="16" depth="192" radius="60" bevel="3" lean="0" pos="0 8 0" material="concord_stone"/>
  <lathe shape="concord_bt_pylon" segments="32" pos="0 16 0" material="concord_ceramic"/>
  <cylinder radius="71" height="4" sides="32" pos="0 21 0" material="concord_graphite"/>
  <torus majorRadius="54" minorRadius="3" majorSegments="32" minorSegments="6" pos="0 36 0" material="glow" unlit="1" castShadow="0"/>
  <cylinder radius="47" height="6" sides="32" pos="0 133 0" material="paint_plain" tint="1"/>
  <cylinder radius="40" height="4" sides="32" pos="0 138 0" material="concord_graphite"/>
  <group rot="0 30 0">
    <shape closed="1" v="26 0 66 0 42 48 30 92" pos="0 22 0" material="paint_plain" tint="1"><extrude amount="8"/><bevel amount="2" bevelSegments="2"/></shape>
    <beam ax="66" ay="22" az="0" bx="42" by="70" bz="0" width="10" depth="4" material="glow" unlit="1" castShadow="0"/>
    <beam ax="67" ay="22" az="0" bx="43" by="70" bz="0" width="12" depth="5" material="concord_core" unlit="1" castShadow="0" renderable="{pulse}"/>
  </group>
  <group rot="0 150 0">
    <shape closed="1" v="26 0 66 0 42 48 30 92" pos="0 22 0" material="paint_plain" tint="1"><extrude amount="8"/><bevel amount="2" bevelSegments="2"/></shape>
    <beam ax="66" ay="22" az="0" bx="42" by="70" bz="0" width="10" depth="4" material="glow" unlit="1" castShadow="0"/>
    <beam ax="67" ay="22" az="0" bx="43" by="70" bz="0" width="12" depth="5" material="concord_core" unlit="1" castShadow="0" renderable="{pulse}"/>
  </group>
  <group rot="0 270 0">
    <shape closed="1" v="26 0 66 0 42 48 30 92" pos="0 22 0" material="paint_plain" tint="1"><extrude amount="8"/><bevel amount="2" bevelSegments="2"/></shape>
    <beam ax="66" ay="22" az="0" bx="42" by="70" bz="0" width="10" depth="4" material="glow" unlit="1" castShadow="0"/>
    <beam ax="67" ay="22" az="0" bx="43" by="70" bz="0" width="12" depth="5" material="concord_core" unlit="1" castShadow="0" renderable="{pulse}"/>
  </group>
</prefab>
