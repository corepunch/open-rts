<!-- Rocket soldier, about 178 cm: the rifleman's body with a launcher tube on the right shoulder. Copied from Scener's CAT biped preset (apps/scener/prefabs/characters/
     presets/biped.blk) and costumed: fatigues in the team colour (tint), a white vest and shoulder pads,
     a yellow helmet, a rocket pack, boots and gloves, and the launcher carried as a rigid bone on the
     ribcage so it is not mirrored onto both hands. Body frame Z up, facing local -Y, the character's left at +X
     (the sprite scene turns the instance to Y up and +X). Lengths in centimetres. -->
<prefab up="z" front="-y">
  <material id="skin" color="0.80 0.62 0.48" shininess="8" />
  <material id="fatigues" color="0.20 0.42 0.88" shininess="12" />
  <material id="vest" color="0.86 0.87 0.88" shininess="30" />
  <material id="helmet" color="0.98 0.78 0.10" shininess="34" />
  <material id="boots" color="0.09 0.10 0.15" shininess="14" />
  <material id="gear" color="0.13 0.16 0.24" shininess="12" />
  <material id="gun" color="0.13 0.14 0.16" shininess="30" />
  <material id="flash" color="1.00 0.80 0.30" />
  <material id="flash_core" color="1.00 1.00 0.90" />
  <!-- The muzzle flash shows on the firing frame only (art/sprites.py turns the option on). -->
  <option name="flash" enabled="0" />

  <hub name="pelvis" aim="0 90" length="14" radius="18 11.5" material="fatigues" tint="1">
    <ellipsoid on="120 -15" at="0.25" radii="9 8 10" sink="4.5" material="fatigues" tint="1" />
    <ellipsoid on="-120 -15" at="0.25" radii="9 8 10" sink="4.5" material="fatigues" tint="1" />
    <ellipsoid on="0 10" at="0.6" radii="17 11 4" sink="4" material="gear" />
    <limb name="left_leg" type="leg" at="0.25" from="90 0" sink="3.8" mirror="1">
      <bone name="left_thigh" aim="0 -90" length="44" radius="12.5 13" taper="0.8" overlap="6" material="fatigues" tint="1">
        <bone name="left_calf" aim="0 -90" length="43" radius="9.5 10" taper="0.7" overlap="4" material="fatigues" tint="1">
          <ellipsoid on="0 0" at="0" radii="6.5 6 6.5" sink="2" material="fatigues" tint="1" />
          <ellipsoid on="0 0" at="0.85" radii="9 10 10" sink="6" material="boots" />
          <ankle name="left_foot" aim="0 -12" length="18" radius="6 5" overlap="3" material="boots">
            <digit name="left_toe" at="1" from="0 -30" aim="0 -6" links="2" length="4" radius="5.5 3.8" taper="0.9" overlap="3" material="boots" />
          </ankle>
        </bone>
      </bone>
    </limb>
    <spine name="spine" links="3" aim="0 90" aimEnd="0 86" length="24" radius="13 9.5" taper="1.1" volume="0" material="fatigues" tint="1">
      <ellipsoid on="0 0" at="0.5" radii="17 12 23" sink="9.8" material="vest" />
      <hub name="ribcage" aim="0 90" length="20" radius="20 13" material="vest">
        <ellipsoid on="40 0" at="0.68" radii="11 5 9.5" sink="2.5" material="vest" />
        <ellipsoid on="-40 0" at="0.68" radii="11 5 9.5" sink="2.5" material="vest" />
        <!-- backpack and the rifle, carried at port arms across the chest -->
        <ellipsoid on="180 0" at="0.45" radii="15 11 17" sink="3" material="gear" />
        <ellipsoid on="160 10" at="0.75" radii="5 5 14" sink="1" material="helmet" />
        <ellipsoid on="-160 10" at="0.75" radii="5 5 14" sink="1" material="helmet" />
        <bone name="weapon" at="1" from="-62 25" aim="0 0" length="74" radius="7.5 7.5" taper="1.1" overlap="24" material="gun">
          <ellipsoid on="0 90" at="1" sink="8" radii="12 12 12" material="flash" unlit="1" castShadow="0" if-feature="flash" />
          <ellipsoid on="0 90" at="1" sink="7" radii="7 7 7" material="flash_core" unlit="1" castShadow="0" if-feature="flash" />
          <ellipsoid on="0 0" at="0.95" radii="7 7 9" sink="3" material="helmet" />
          <ellipsoid on="0 -90" at="0.55" radii="3 6 6" sink="2" material="gun" />
          <ellipsoid on="0 90" at="0.6" radii="3 7 4" sink="2" material="gear" />
        </bone>
        <limb name="left_arm" type="arm" at="0.9" from="90 0" mirror="1">
          <collarbone name="left_collarbone" aim="90 0" length="8" radius="4" material="fatigues" tint="1">
            <bone name="left_upperarm" aim="90 -82" length="29" radius="8 8.5" taper="0.8" overlap="4" material="fatigues" tint="1">
              <ellipsoid on="90 20" at="0.08" radii="8 8 8" sink="6" material="vest" />
              <bone name="left_forearm" aim="0 -86" length="26" radius="6 6.2" taper="0.8" material="fatigues" tint="1">
                <palm name="left_palm" aim="0 -90" length="12" radius="4 5" overlap="2" material="boots" />
              </bone>
            </bone>
          </collarbone>
        </limb>
        <spine name="neck" aim="0 90" aimEnd="0 80" length="9" radius="5.5" material="skin">
          <hub name="head" aim="0 90" length="21" radius="8 9.5" material="skin">
            <bone name="helmet" at="0.62" from="0 90" aim="0 90" length="13" radius="14 15" sink="9" material="helmet" />
            <ellipsoid on="0 -10" at="0.45" radii="7 2 2.2" sink="0.5" material="gear" />
          </hub>
        </spine>
      </hub>
    </spine>
  </hub>

  <!-- Pose library, the rifleman's with the launcher on the right shoulder (weapon pos), the
       right hand on its grip and the left under the tube. Arm IK offsets are in the instance's
       frame, from the rest wrists (27.5, -2.7, 91.7; read with scener list-joints), so a pose
       that moves the torso moves the hand offsets with it: -Y is forward, Z up. -->
  <pose name="Ready">
    <joint target="pelvis" pos="3 1 -3" rot="0 -4 6" />
    <ik limb="left_leg" offset="3 -9 0" bend="10 0" />
    <ik limb="right_leg" offset="-7 11 0" bend="-25 0" />
    <joint target="right_foot" aim="-30 -12" />
    <joint target="spine" aim="0 87" />
    <joint target="ribcage" rot="0 3 -8" />
    <joint target="head" rot="-6 0 14" />
    <joint target="weapon" pos="-12 0 4" aim="0 6" />
    <ik limb="right_arm" offset="10.5 -11.3 48.3" bend="-90 -40" />
    <ik limb="left_arm" offset="-39.5 -33.3 50.3" bend="90 -30" />
  </pose>
  <!-- Running: the torso leans into it and the rifle is carried low across the body. -->
  <pose name="Run">
    <joint target="spine" aim="0 74" />
    <joint target="head" rot="-12 0 0" />
    <joint target="weapon" pos="-12 0 4" aim="0 14" />
    <ik limb="right_arm" offset="10.5 -24 46" bend="-90 -40" />
    <ik limb="left_arm" offset="-39.5 -42 49" bend="90 -30" />
  </pose>
  <!-- Firing stance: feet apart, knees bent, weight forward. -->
  <pose name="Aim">
    <joint target="pelvis" pos="0 -2 -8" />
    <ik limb="left_leg" offset="2 -16 0" />
    <ik limb="right_leg" offset="-2 12 0" />
    <joint target="spine" aim="0 82" />
    <joint target="weapon" pos="-12 0 4" aim="0 8" />
    <ik limb="right_arm" offset="10.5 -20 39.5" bend="-90 -40" />
    <ik limb="left_arm" offset="-39.5 -42 41.5" bend="90 -30" />
    <joint target="head" rot="2 0 -10" />
  </pose>
  <pose name="Recoil">
    <joint target="pelvis" pos="0 3 -9" />
    <ik limb="left_leg" offset="2 -16 0" />
    <ik limb="right_leg" offset="-2 12 0" />
    <joint target="spine" aim="0 98" />
    <joint target="weapon" pos="-12 4 5" aim="0 -6" />
    <ik limb="right_arm" offset="10.5 -3 40" bend="-90 -40" />
    <ik limb="left_arm" offset="-39.5 -24 44" bend="90 -30" />
    <joint target="head" rot="-6 0 -10" />
  </pose>
  <!-- Death: shot, the soldier jerks and lets go with the left hand, the knees give, he drops to
       his knees, topples forward and ends face down, one arm under him, legs loose. Limbs are posed
       by aim (relative to the parent), the pelvis by pos and aim; no arm ever goes out flat. -->
  <pose name="Hit">
    <joint target="pelvis" pos="0 7 -5" />
    <ik limb="left_leg" offset="2 -16 0" />
    <ik limb="right_leg" offset="-2 12 0" />
    <joint target="spine" aim="180 78" />
    <joint target="ribcage" rot="-12 6 14" />
    <joint target="head" rot="-28 0 -12" />
    <joint target="weapon" aim="-30 -40" />
    <ik limb="right_arm" offset="18 -10 24" bend="-90 -40" />
    <ik limb="left_arm" offset="-20 -10 34" bend="90 -60" />
  </pose>
  <pose name="Buckle">
    <joint target="pelvis" pos="0 2 -30" rot="0 0 -10" />
    <ik limb="left_leg" offset="2 -16 0" bend="0 0" />
    <ik limb="right_leg" offset="-2 12 0" bend="-10 0" />
    <joint target="spine" aim="0 68" />
    <joint target="ribcage" rot="12 -6 8" />
    <joint target="head" rot="26 0 -8" />
    <joint target="weapon" aim="-20 -72" />
    <ik limb="right_arm" offset="14 -16 -6" bend="-90 -30" />
    <ik limb="left_arm" offset="-22 -18 4" bend="90 -60" />
  </pose>
  <pose name="Kneel">
    <joint target="pelvis" pos="0 4 -50" rot="0 0 -14" />
    <ik limb="left_leg" offset="2 20 0" bend="0 0" />
    <ik limb="right_leg" offset="-4 26 0" bend="0 0" />
    <joint target="spine" aim="0 58" />
    <joint target="ribcage" rot="14 -10 10" />
    <joint target="head" rot="34 0 -14" />
    <joint target="weapon" aim="-50 -80" />
    <joint target="right_upperarm" aim="-80 -80" />
    <joint target="right_forearm" aim="0 -70" />
    <joint target="left_upperarm" aim="70 -70" />
    <joint target="left_forearm" aim="0 -60" />
  </pose>
  <pose name="Topple">
    <joint target="pelvis" pos="0 -12 -62" aim="0 38" rot="0 -12 0" />
    <ik limb="left_leg" offset="2 24 0" bend="0 0" />
    <ik limb="right_leg" offset="-4 30 0" bend="0 -20" />
    <joint target="spine" aim="0 76" />
    <joint target="ribcage" rot="4 -14 6" />
    <joint target="head" rot="10 0 -24" />
    <joint target="weapon" aim="-70 -60" />
    <joint target="right_upperarm" aim="-40 -40" />
    <joint target="right_forearm" aim="0 -30" />
    <joint target="left_upperarm" aim="40 -60" />
    <joint target="left_forearm" aim="10 -40" />
  </pose>
  <pose name="Dead">
    <joint target="pelvis" pos="0 -60 -77" aim="0 2" rot="0 -16 0" />
    <joint target="left_thigh" aim="50 -70" />
    <joint target="left_calf" aim="-80 -40" />
    <joint target="right_thigh" aim="-6 -86" />
    <joint target="right_calf" aim="-30 -80" />
    <joint target="spine" aim="0 88" />
    <joint target="ribcage" rot="0 -6 4" />
    <joint target="head" rot="0 0 -70" />
    <joint target="weapon" aim="-80 40" />
    <joint target="right_upperarm" aim="-60 20" />
    <joint target="right_forearm" aim="40 30" />
    <joint target="left_upperarm" aim="65 -70" />
    <joint target="left_forearm" aim="10 -20" />
  </pose>

  <!-- Clips (seconds). The sprite renderer samples them at fixed times (art/sprites.py). -->
  <!-- Standing guard: a slow look left and right with the weight shifting. -->
  <clip name="Idle" length="2.4" loop="1">
    <key t="0" pose="Ready" />
    <key t="0.6" pose="Ready"><joint target="pelvis" pos="4 1 -3.5" rot="0 -4 7" /><joint target="ribcage" rot="0 3 -2" /><joint target="head" rot="-4 0 34" /></key>
    <key t="1.2" pose="Ready"><joint target="pelvis" pos="3 1 -2.5" rot="0 -4 6" /><joint target="ribcage" rot="3 3 -8" /><joint target="head" rot="-12 0 8" /></key>
    <key t="1.8" pose="Ready"><joint target="pelvis" pos="2 1 -3" rot="0 -3 4" /><joint target="ribcage" rot="0 2 -14" /><joint target="head" rot="-2 0 -18" /></key>
  </clip>
  <!-- Added over the running gait, two nods of the chest a stride (the gait's cycle is 0.5 s). -->
  <clip name="RunBob" length="0.5" loop="1">
    <key t="0"><joint target="ribcage" rot="4 0 0" /></key>
    <key t="0.125"><joint target="ribcage" rot="-4 0 0" /></key>
    <key t="0.25"><joint target="ribcage" rot="4 0 0" /></key>
    <key t="0.375"><joint target="ribcage" rot="-4 0 0" /></key>
  </clip>
  <clip name="Fire" length="0.3" loop="1">
    <key t="0" pose="Aim" ease="step" />
    <key t="0.1" pose="Recoil" ease="step" />
    <key t="0.2" pose="Aim" ease="step" />
  </clip>
  <clip name="Die" length="1.0">
    <key t="0" pose="Aim" />
    <key t="0.1" pose="Hit" />
    <key t="0.3" pose="Buckle" />
    <key t="0.5" pose="Kneel" />
    <key t="0.7" pose="Topple" />
    <key t="0.88" pose="Dead" />
  </clip>
</prefab>
