<!-- Rifleman, about 178 cm. Copied from Scener's CAT biped preset (apps/scener/prefabs/characters/
     presets/biped.blk) and costumed: desert fatigues, a team-colour vest and shoulder pads (tint),
     a helmet, a backpack, boots and gloves, and a rifle carried as a rigid bone on the ribcage so it
     is not mirrored onto both hands. Body frame Z up, facing local -Y, the character's left at +X
     (the sprite scene turns the instance to Y up and +X). Lengths in centimetres. -->
<prefab up="z" front="-y">
  <material id="skin" color="0.80 0.62 0.48" shininess="8" />
  <material id="fatigues" color="0.33 0.37 0.25" shininess="5" />
  <material id="vest" color="0.20 0.42 0.88" shininess="12" />
  <material id="helmet" color="0.22 0.25 0.18" shininess="18" />
  <material id="boots" color="0.16 0.14 0.12" shininess="8" />
  <material id="gear" color="0.30 0.28 0.22" shininess="6" />
  <material id="gun" color="0.13 0.14 0.16" shininess="30" />
  <material id="flash" color="1.00 0.80 0.30" />
  <material id="flash_core" color="1.00 1.00 0.90" />
  <!-- The muzzle flash shows on the firing frame only (art/sprites.py turns the option on). -->
  <option name="flash" enabled="0" />

  <hub name="pelvis" aim="0 90" length="14" radius="18 11.5" material="fatigues">
    <ellipsoid on="120 -15" at="0.25" radii="9 8 10" sink="4.5" material="fatigues" />
    <ellipsoid on="-120 -15" at="0.25" radii="9 8 10" sink="4.5" material="fatigues" />
    <ellipsoid on="0 10" at="0.6" radii="17 11 4" sink="4" material="gear" />
    <limb name="left_leg" type="leg" at="0.25" from="90 0" sink="3.8" mirror="1">
      <bone name="left_thigh" aim="0 -90" length="44" radius="12.5 13" taper="0.8" overlap="6" material="fatigues">
        <bone name="left_calf" aim="0 -90" length="43" radius="9.5 10" taper="0.7" overlap="4" material="fatigues">
          <ellipsoid on="0 0" at="0" radii="6.5 6 6.5" sink="2" material="fatigues" />
          <ellipsoid on="0 0" at="0.85" radii="9 10 10" sink="6" material="boots" />
          <ankle name="left_foot" aim="0 -12" length="18" radius="6 5" overlap="3" material="boots">
            <digit name="left_toe" at="1" from="0 -30" aim="0 -6" links="2" length="4" radius="5.5 3.8" taper="0.9" overlap="3" material="boots" />
          </ankle>
        </bone>
      </bone>
    </limb>
    <spine name="spine" links="3" aim="0 90" aimEnd="0 86" length="24" radius="13 9.5" taper="1.1" volume="0" material="fatigues">
      <ellipsoid on="0 0" at="0.5" radii="17 12 23" sink="9.8" material="vest" tint="1" />
      <hub name="ribcage" aim="0 90" length="20" radius="20 13" material="vest" tint="1">
        <ellipsoid on="40 0" at="0.68" radii="11 5 9.5" sink="2.5" material="vest" tint="1" />
        <ellipsoid on="-40 0" at="0.68" radii="11 5 9.5" sink="2.5" material="vest" tint="1" />
        <!-- backpack and the rifle, carried at port arms across the chest -->
        <ellipsoid on="180 0" at="0.45" radii="15 11 17" sink="3" material="gear" />
        <bone name="weapon" at="0.45" from="0 -10" aim="-35 5" length="82" radius="3.4 4" taper="0.7" material="gun">
          <ellipsoid on="0 90" at="1" sink="4" radii="8 8 8" material="flash" unlit="1" castShadow="0" if-feature="flash" />
          <ellipsoid on="0 90" at="1" sink="4" radii="4.5 4.5 4.5" material="flash_core" unlit="1" castShadow="0" if-feature="flash" />
          <ellipsoid on="0 -90" at="0.35" radii="2.2 5 7" sink="2" material="gun" />
        </bone>
        <limb name="left_arm" type="arm" at="0.9" from="90 0" mirror="1">
          <collarbone name="left_collarbone" aim="90 0" length="8" radius="4" material="fatigues">
            <bone name="left_upperarm" aim="90 -82" length="29" radius="8 8.5" taper="0.8" overlap="4" material="fatigues">
              <ellipsoid on="90 20" at="0.08" radii="8 8 8" sink="6" material="vest" tint="1" />
              <bone name="left_forearm" aim="0 -86" length="26" radius="6 6.2" taper="0.8" material="fatigues">
                <palm name="left_palm" aim="0 -90" length="12" radius="4 5" overlap="2" material="boots" />
              </bone>
            </bone>
          </collarbone>
        </limb>
        <spine name="neck" aim="0 90" aimEnd="0 80" length="9" radius="5.5" material="skin">
          <hub name="head" aim="0 90" length="21" radius="8 9.5" material="skin">
            <bone name="helmet" at="0.62" from="0 90" aim="0 90" length="13" radius="14 15" sink="9" material="helmet" />
            <ellipsoid on="0 -10" at="0.45" radii="7 2 2.2" sink="0.5" material="gear" />
          </hub>
        </spine>
      </hub>
    </spine>
  </hub>

  <!-- Pose library. Hands go on the rifle: the right wrist behind the grip, the left under the
       fore-end. Arm IK offsets are in the instance's frame, from the rest wrists
       (25.5, -2.7, 91.7; rifle base 0, -10.8, 135.6; read with scener list-joints), so a pose that
       moves the torso moves the hand offsets with it: -Y is forward, Z up. -->
  <pose name="Ready">
    <joint target="weapon" aim="0 -15" />
    <ik limb="right_arm" offset="19.5 -14.3 35.3" bend="-90 -40" />
    <ik limb="left_arm" offset="-21.5 -36.3 29.3" bend="90 -40" />
  </pose>
  <!-- Running: the torso leans into it and the rifle is carried low across the body. -->
  <pose name="Run">
    <joint target="spine" aim="0 74" />
    <joint target="head" rot="-12 0 0" />
    <joint target="weapon" aim="-25 -22" />
    <ik limb="right_arm" offset="17 -24 28" bend="-90 -50" />
    <ik limb="left_arm" offset="-10 -48 14" bend="90 -50" />
  </pose>
  <!-- Firing stance: feet apart, knees bent, weight forward. -->
  <pose name="Aim">
    <joint target="pelvis" pos="0 -2 -8" />
    <ik limb="left_leg" offset="2 -16 0" />
    <ik limb="right_leg" offset="-2 12 0" />
    <joint target="spine" aim="0 82" />
    <joint target="weapon" aim="0 8" />
    <ik limb="right_arm" offset="19.5 -22 27" bend="-90 -30" />
    <ik limb="left_arm" offset="-21.5 -48 27" bend="90 -30" />
    <joint target="head" rot="2 0 0" />
  </pose>
  <pose name="Recoil">
    <joint target="pelvis" pos="0 3 -9" />
    <ik limb="left_leg" offset="2 -16 0" />
    <ik limb="right_leg" offset="-2 12 0" />
    <joint target="spine" aim="0 96" />
    <joint target="weapon" aim="0 -4" />
    <ik limb="right_arm" offset="19.5 -6 31" bend="-90 -30" />
    <ik limb="left_arm" offset="-21.5 -32 36" bend="90 -30" />
    <joint target="head" rot="-6 0 0" />
  </pose>
  <!-- Death, thrown backward (+Y): the spine snaps into an arc, head and arms fly back, the body
       leaves the ground, lands on its back and settles sprawled. Limbs are posed by aim, which
       follows the body; limb IK would stay where the soldier stood. -->
  <pose name="Hit">
    <joint target="pelvis" pos="0 6 -6" aim="180 80" />
    <joint target="spine" aim="180 72" />
    <joint target="ribcage" rot="-18 0 8" />
    <joint target="head" rot="-34 0 0" />
    <joint target="weapon" aim="20 60" />
    <joint target="left_thigh" aim="0 -70" />
    <joint target="left_calf" aim="180 -60" />
    <joint target="right_thigh" aim="180 -80" />
    <joint target="right_upperarm" aim="-70 55" />
    <joint target="right_forearm" aim="0 70" />
    <joint target="left_upperarm" aim="100 20" />
    <joint target="left_forearm" aim="60 30" />
  </pose>
  <pose name="Thrown">
    <joint target="pelvis" pos="0 28 -8" aim="180 46" />
    <joint target="spine" aim="180 60" />
    <joint target="ribcage" rot="-20 0 -6" />
    <joint target="head" rot="-38 0 12" />
    <joint target="weapon" aim="70 80" />
    <joint target="left_thigh" aim="0 -50" />
    <joint target="left_calf" aim="180 -50" />
    <joint target="right_thigh" aim="0 -75" />
    <joint target="right_calf" aim="180 -75" />
    <joint target="right_upperarm" aim="-90 75" />
    <joint target="right_forearm" aim="0 80" />
    <joint target="left_upperarm" aim="120 50" />
    <joint target="left_forearm" aim="90 60" />
  </pose>
  <pose name="Land">
    <joint target="pelvis" pos="0 48 -62" aim="180 14" />
    <joint target="ribcage" rot="-10 0 0" />
    <joint target="head" rot="-24 0 16" />
    <joint target="weapon" aim="90 20" />
    <joint target="left_thigh" aim="0 -40" />
    <joint target="left_calf" aim="180 -40" />
    <joint target="right_thigh" aim="-10 -65" />
    <joint target="right_calf" aim="180 -70" />
    <joint target="right_upperarm" aim="-100 40" />
    <joint target="right_forearm" aim="-20 30" />
    <joint target="left_upperarm" aim="120 25" />
    <joint target="left_forearm" aim="60 20" />
  </pose>
  <pose name="Dead">
    <joint target="pelvis" pos="0 54 -76" aim="180 4" />
    <joint target="ribcage" rot="-3 0 6" />
    <joint target="head" rot="-8 0 30" />
    <joint target="weapon" aim="100 -8" />
    <joint target="left_thigh" aim="25 -78" />
    <joint target="left_calf" aim="150 -84" />
    <joint target="right_thigh" aim="-14 -88" />
    <joint target="right_upperarm" aim="-115 -4" />
    <joint target="right_forearm" aim="-60 -4" />
    <joint target="left_upperarm" aim="125 2" />
    <joint target="left_forearm" aim="40 -4" />
  </pose>

  <!-- Clips (seconds). The sprite renderer samples them at fixed times (art/sprites.py). -->
  <!-- Standing guard: a slow look left and right with the weight shifting. -->
  <clip name="Idle" length="2.4" loop="1">
    <key t="0" pose="Ready" />
    <key t="0.6" pose="Ready"><joint target="head" rot="0 0 28" /><joint target="ribcage" rot="0 0 8" /><joint target="pelvis" pos="2 0 -1" /></key>
    <key t="1.2" pose="Ready"><joint target="ribcage" rot="3 0 0" /></key>
    <key t="1.8" pose="Ready"><joint target="head" rot="0 0 -28" /><joint target="ribcage" rot="0 0 -8" /><joint target="pelvis" pos="-2 0 -1" /></key>
  </clip>
  <!-- Added over the running gait, two nods of the chest a stride (the gait's cycle is 0.5 s). -->
  <clip name="RunBob" length="0.5" loop="1">
    <key t="0"><joint target="ribcage" rot="4 0 0" /></key>
    <key t="0.125"><joint target="ribcage" rot="-4 0 0" /></key>
    <key t="0.25"><joint target="ribcage" rot="4 0 0" /></key>
    <key t="0.375"><joint target="ribcage" rot="-4 0 0" /></key>
  </clip>
  <clip name="Fire" length="0.3" loop="1">
    <key t="0" pose="Aim" ease="step" />
    <key t="0.1" pose="Recoil" ease="step" />
    <key t="0.2" pose="Aim" ease="step" />
  </clip>
  <clip name="Die" length="1.0">
    <key t="0" pose="Aim" />
    <key t="0.15" pose="Hit" />
    <key t="0.4" pose="Thrown" />
    <key t="0.65" pose="Land" />
    <key t="0.85" pose="Dead" />
  </clip>
</prefab>
