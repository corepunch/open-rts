<?xml version="1.0" encoding="UTF-8"?>
<!-- Self-propelled Artillery. Length 270 cm on X, width 156 cm on Z, origin at the hull centre
     on the ground, gun faces +X. Tracked chassis with skirts, a big faceted casemate at the
     back (tapered top-view profile), and a very long howitzer raised 28 degrees on a
     trunnion cradle; folded recoil spades and ammunition racks at the rear. -->
<prefab up="y" front="+x">
  <include src="../../utilities.xml"/>
  <include src="../../kit.xml"/>
  <!-- Animation knob, set per frame by art/sprites.py: move 0/1 steps the running gear. -->
  <let name="move" value="0"/>
  <!-- Animation knob, set per frame by art/sprites.py: fire 1 is the shot (flash, full recoil),
       fire 2 the barrel running back out. -->
  <let name="fire" value="0"/>
  <let name="kick" value="fire == 1 ? 22 : (fire == 2 ? 9 : 0)"/>
  <soft-box width="256" height="42" depth="38" radius="19" bevel="3" pos="0 21 58" material="track"><map type="bricks" size="16 60 60" mortar="3.5" bond="0" offset="{8*move} 0 0" from="1.3 1.27 1.25" to="0.4 0.4 0.4"/></soft-box>
  <soft-box width="256" height="42" depth="38" radius="19" bevel="3" pos="0 21 -58" material="track"><map type="bricks" size="16 60 60" mortar="3.5" bond="0" offset="{8*move} 0 0" from="1.3 1.27 1.25" to="0.4 0.4 0.4"/></soft-box>
  <cylinder radius="13" height="40" sides="10" rot="90 0 {18*move}" pos="-100 19 58" material="steel_dark"><array count="6" translation="40 0 0"/></cylinder>
  <cylinder radius="13" height="40" sides="10" rot="90 0 {18*move}" pos="-100 19 -58" material="steel_dark"><array count="6" translation="40 0 0"/></cylinder>
  <box size="230 20 5" rot="-14 0 0" pos="-4 42 79" material="armor"/>
  <box size="230 20 5" rot="14 0 0" pos="-4 42 -79" material="armor"/>

  <!-- low hull -->
  <shape closed="1" v="-130 36 110 36 134 52 116 70 -130 70" material="armor">
    <extrude amount="144"/><bevel amount="2" bevelSegments="1"/>
    <taper center="0 36 0" amount="-0.12" axis="y" effect="z"/>
  </shape>
  <box size="6 8 120" pos="132 50 0" material="hazard"/>
  <box size="5 5 3" pos="128 58 44" material="lamp" unlit="1" castShadow="0"/>
  <box size="5 5 3" pos="128 58 -44" material="lamp" unlit="1" castShadow="0"/>

  <!-- casemate -->
  <group pos="-40 96 0">
    <shape closed="1" v="70 0 52 52 -66 56 -78 40 -78 -40 -66 -56 52 -52" rot="90 0 0" material="armor">
      <extrude amount="52"/><bevel amount="2" bevelSegments="1"/>
      <taper center="0 0 0" amount="0.3" axis="z"/>
    </shape>
    <shape closed="1" v="50 0 36 38 -50 40 -60 28 -60 -28 -50 -40 36 -38" rot="90 0 0" pos="0 26.6 0" material="team" tint="1">
      <extrude amount="1.2"/>
    </shape>
    <cylinder radius="11" height="8" sides="8" pos="-40 30 26" material="gunmetal"/>
    <vent width="30" depth="24" height="6" pos="-46 26 -24"/>
    <cylinder radius="1" height="90" sides="5" pos="-64 70 -36" material="steel_dark"/>
  </group>
  <!-- ammunition racks on the back -->
  <box size="14 30 100" pos="-128 70 0" material="steel_dark"/>
  <cylinder radius="4" height="26" sides="8" pos="-138 72 -36" material="ore"><array count="5" translation="0 0 18"/></cylinder>
  <!-- howitzer -->
  <group pos="22 112 0" rot="0 0 28">
    <box size="50 36 46" material="gunmetal"/>
    <box size="70 12 36" pos="40 -16 0" material="steel_dark"/>
    <cylinder radius="7" height="230" sides="10" rot="0 0 -90" pos="{135-kick} 0 0" material="steel_dark"/>
    <cylinder radius="10" height="28" sides="10" rot="0 0 -90" pos="120 0 0" material="gunmetal"/>
    <box size="26 18 22" pos="{250-kick} 0 0" material="steel_dark"/>
    <box size="6 22 26" pos="{243-kick} 0 0" material="steel_dark"/>
    <muzzle-flash pos="{264-kick} 0 0" scale="1.9 1.9 1.9" on="{fire == 1}"/>
  </group>
  <!-- folded spades -->
  <box size="8 46 40" rot="0 0 -28" pos="-140 46 46" material="hazard"/>
  <box size="8 46 40" rot="0 0 -28" pos="-140 46 -46" material="hazard"/>
</prefab>
