<?xml version="1.0" encoding="UTF-8"?>
<!-- Self-propelled Artillery. Length 260 cm on X, width 150 cm on Z, origin at the hull centre
     on the ground, gun faces +X. Low tracked chassis, a boxy casemate and a long howitzer
     raised 30 degrees, recoil spades folded at the back. -->
<prefab up="y" front="+x">
  <include src="../../utilities.xml"/>
  <soft-box width="250" height="44" depth="36" radius="20" bevel="4" pos="0 22 57" material="track"/>
  <soft-box width="250" height="44" depth="36" radius="20" bevel="4" pos="0 22 -57" material="track"/>
  <cylinder radius="12" height="40" rot="90 0 0" pos="-96 20 57" material="steel_dark"><array count="6" translation="38.4 0 0"/></cylinder>
  <cylinder radius="12" height="40" rot="90 0 0" pos="-96 20 -57" material="steel_dark"><array count="6" translation="38.4 0 0"/></cylinder>

  <shape closed="1" v="-125 38 106 38 128 54 110 70 -125 70" material="armor">
    <extrude amount="140"/><bevel amount="4" bevelSegments="2"/>
  </shape>
  <!-- casemate, y 70..126 -->
  <soft-box width="130" height="56" depth="104" radius="12" bevel="4" pos="-44 98 0" material="armor"/>
  <soft-box width="134" height="10" depth="108" radius="13" bevel="3" pos="-44 116 0" material="team" tint="1"/>
  <cylinder radius="12" height="8" pos="-80 130 30" material="armor_dark"/>
  <!-- howitzer: trunnion at (20, 108), 30 degrees up -->
  <group pos="20 108 0" rot="0 0 30">
    <soft-box width="40" height="34" depth="44" radius="8" bevel="3" material="armor_dark"/>
    <cylinder radius="7" height="210" rot="0 0 -90" pos="120 0 0" material="steel_dark"/>
    <cylinder radius="10" height="60" rot="0 0 -90" pos="50 -10 0" material="steel"/>
    <cylinder radius="11" height="20" rot="0 0 -90" pos="224 0 0" material="steel"/>
  </group>
  <!-- folded spades -->
  <box size="10 50 40" rot="0 0 -25" pos="-136 46 42" material="hazard"/>
  <box size="10 50 40" rot="0 0 -25" pos="-136 46 -42" material="hazard"/>
</prefab>
