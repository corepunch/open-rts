<?xml version="1.0" encoding="UTF-8"?>
<!-- Battle Tank, assembled: tank/hull plus tank/turret on its ring at (-12, 102, 0). Length 250 cm on X, origin at the hull centre on the ground, gun faces +X. Sprites render hull and turret as separate layers (art/sprites.py). -->
<prefab up="y" front="+x">
  <prefab source="vehicles/tank/hull"/>
  <prefab source="vehicles/tank/turret" pos="-12 102 0"/>
</prefab>
