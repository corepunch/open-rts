<?xml version="1.0" encoding="UTF-8"?>
<!-- Armoured Personnel Carrier. Length 260 cm on X, width 150 cm on Z, origin at the hull
     centre on the ground, nose faces +X. Eight-wheel boxy hull with a sloped glacis, a small
     machine-gun turret and a rear troop door. -->
<prefab up="y" front="+x">
  <include src="../../utilities.xml"/>
  <group pos="0 26 0">
    <cylinder radius="26" height="24" sides="16" rot="90 0 0" pos="96 0 62" material="rubber"><array count="4" translation="-62 0 0"/></cylinder>
    <cylinder radius="26" height="24" sides="16" rot="90 0 0" pos="96 0 -62" material="rubber"><array count="4" translation="-62 0 0"/></cylinder>
    <cylinder radius="11" height="26" rot="90 0 0" pos="96 0 62" material="steel_dark"><array count="4" translation="-62 0 0"/></cylinder>
    <cylinder radius="11" height="26" rot="90 0 0" pos="96 0 -62" material="steel_dark"><array count="4" translation="-62 0 0"/></cylinder>
  </group>
  <shape closed="1" v="-126 34 96 34 132 66 104 104 -120 104 -130 90" material="armor">
    <extrude amount="128"/><bevel amount="5" bevelSegments="2"/>
  </shape>
  <box size="180 12 132" pos="-30 80 0" material="team" tint="1"/>
  <box size="24 8 3" pos="96 96 50" material="glass"/>
  <box size="24 8 3" pos="96 96 -50" material="glass"/>
  <box size="4 44 60" pos="-131 66 0" material="armor_dark"/>
  <sphere radius="4" pos="122 70 44" material="lamp" unlit="1" castShadow="0"/>
  <sphere radius="4" pos="122 70 -44" material="lamp" unlit="1" castShadow="0"/>
  <!-- turret -->
  <cylinder radius="28" height="24" sides="12" pos="10 116 0" material="armor_dark"/>
  <cylinder radius="3.5" height="60" rot="0 0 -90" pos="66 118 0" material="steel_dark"/>
  <box size="20 10 46" pos="-70 109 0" material="armor_dark"/>
</prefab>
