<?xml version="1.0" encoding="UTF-8"?>
<!-- Scout Buggy. Length 176 cm on X, width 130 cm on Z, origin at the chassis centre on the
     ground, nose faces +X. Big knobbly wheels under angular fenders, a wedge body, a tube roll
     cage with a pintle machine gun, a spotlight and a spare wheel. Team paint, with white panels
     on the hood and the deck. -->
<prefab up="y" front="+x">
  <include src="../../utilities.xml"/>
  <include src="../../kit.xml"/>
  <!-- Animation knob, set per frame by art/sprites.py: move 0/1 steps the running gear. -->
  <let name="move" value="0"/>
  <!-- Animation knob, set per frame by art/sprites.py: fire 1 is the shot (flash, full recoil),
       fire 2 the barrel running back out. -->
  <let name="fire" value="0"/>
  <let name="kick" value="fire == 1 ? 4 : (fire == 2 ? 1 : 0)"/>
  <group pos="0 27 0">
    <cylinder radius="27" height="24" sides="12" rot="90 0 0" pos="56 0 53" material="rubber"/>
    <cylinder radius="27" height="24" sides="12" rot="90 0 0" pos="-56 0 53" material="rubber"/>
    <cylinder radius="27" height="24" sides="12" rot="90 0 0" pos="56 0 -53" material="rubber"/>
    <cylinder radius="27" height="24" sides="12" rot="90 0 0" pos="-56 0 -53" material="rubber"/>
    <cylinder radius="11" height="26" sides="6" rot="90 0 {30*move}" pos="56 0 53" material="gunmetal"/>
    <cylinder radius="11" height="26" sides="6" rot="90 0 {30*move}" pos="-56 0 53" material="gunmetal"/>
    <cylinder radius="11" height="26" sides="6" rot="90 0 {30*move}" pos="56 0 -53" material="gunmetal"/>
    <cylinder radius="11" height="26" sides="6" rot="90 0 {30*move}" pos="-56 0 -53" material="gunmetal"/>
  </group>
  <box size="156 14 74" pos="0 40 0" material="steel_dark"/>
  <!-- fenders: angled plates over each wheel pair -->
  <box size="64 4 30" rot="-10 0 0" pos="56 58 52" material="trim"/>
  <box size="64 4 30" rot="10 0 0" pos="56 58 -52" material="trim"/>
  <box size="64 4 30" rot="-10 0 0" pos="-56 58 52" material="trim"/>
  <box size="64 4 30" rot="10 0 0" pos="-56 58 -52" material="trim"/>
  <!-- wedge body -->
  <shape closed="1" v="-82 44 62 44 90 56 64 66 30 68 6 84 -64 84 -82 70" material="paint_plain" tint="1">
    <extrude amount="84"/><bevel amount="4" bevelSegments="2"/>
    <taper center="0 46 0" amount="-0.15" axis="y" effect="z"/>
  </shape>
  <box size="30 2 56" rot="0 0 -21" pos="76 62 0" material="trim_light"/>
  <box size="3 16 64" rot="0 0 -34" pos="18 77 0" material="glass"/>
  <box size="56 2 60" pos="-30 85 0" material="trim_light"/>
  <box size="4 4 3" pos="88 56 30" material="lamp" unlit="1" castShadow="0"/>
  <box size="4 4 3" pos="88 56 -30" material="lamp" unlit="1" castShadow="0"/>
  <!-- roll cage -->
  <tube ax="-48" ay="74" az="34" bx="-38" by="124" bz="28" r0="2.6" material="steel_dark"/>
  <tube ax="-48" ay="74" az="-34" bx="-38" by="124" bz="-28" r0="2.6" material="steel_dark"/>
  <tube ax="-38" ay="124" az="28" bx="-38" by="124" bz="-28" r0="2.6" material="steel_dark"/>
  <tube ax="30" ay="72" az="32" bx="-38" by="124" bz="28" r0="2.6" material="steel_dark"/>
  <tube ax="30" ay="72" az="-32" bx="-38" by="124" bz="-28" r0="2.6" material="steel_dark"/>
  <!-- pintle gun and spotlight -->
  <cylinder radius="2" height="12" sides="6" pos="-30 130 0" material="steel_dark"/>
  <box size="36 8 8" pos="-22 138 0" material="gunmetal"/>
  <box size="10 10 6" pos="-26 132 6" material="ore"/>
  <cylinder radius="2" height="44" sides="6" rot="0 0 -90" pos="{18-kick} 138 0" material="steel_dark"/>
  <muzzle-flash pos="{41-kick} 138 0" scale="0.6 0.6 0.6" on="{fire == 1}"/>
  <box size="10 8 10" pos="-38 130 24" material="gunmetal"/>
  <box size="1 6 8" pos="-32.5 130 24" material="lamp" unlit="1" castShadow="0"/>
  <!-- spare wheel and jerrycans -->
  <cylinder radius="18" height="12" sides="12" rot="0 0 90" pos="-86 64 0" material="rubber"/>
  <box size="12 18 8" pos="-70 82 26" material="trim"/>
  <box size="12 18 8" pos="-70 82 -26" material="hazard"/>
</prefab>
