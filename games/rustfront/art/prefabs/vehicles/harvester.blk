<?xml version="1.0" encoding="UTF-8"?>
<!-- Ore Harvester. Length 310 cm on X, width 166 cm on Z, origin at the chassis centre on the
     ground, cab and pickup face +X. A heavy six-wheel mining truck: a white forward cab, a
     ribbed hopper in team paint with a gold rim, heaped with ore, twin exhaust stacks and a
     toothed pickup drum on arms; amber beacons. -->
<prefab up="y" front="+x">
  <include src="../../utilities.xml"/>
  <include src="../../kit.xml"/>
  <!-- Animation knob, set per frame by art/sprites.py: move 0/1 steps the running gear. -->
  <let name="move" value="0"/>
  <group pos="0 31 0">
    <cylinder radius="31" height="32" sides="12" rot="90 0 0" pos="90 0 66" material="rubber"><array count="3" translation="-95 0 0"/></cylinder>
    <cylinder radius="31" height="32" sides="12" rot="90 0 0" pos="90 0 -66" material="rubber"><array count="3" translation="-95 0 0"/></cylinder>
    <cylinder radius="14" height="34" sides="8" rot="90 0 {22.5*move}" pos="90 0 66" material="gunmetal"><array count="3" translation="-95 0 0"/></cylinder>
    <cylinder radius="14" height="34" sides="8" rot="90 0 {22.5*move}" pos="90 0 -66" material="gunmetal"><array count="3" translation="-95 0 0"/></cylinder>
  </group>
  <box size="296 22 100" pos="0 52 0" material="steel_dark"/>
  <box size="300 4 150" pos="0 64 0" material="grating"/>
  <!-- cab -->
  <group pos="112 66 0">
    <shape closed="1" v="-36 0 36 0 40 30 28 62 -36 64" material="trim_light">
      <extrude amount="140"/><bevel amount="4" bevelSegments="2"/>
      <taper center="0 0 0" amount="-0.14" axis="y" effect="z"/>
    </shape>
    <box size="4 22 116" rot="0 0 21" pos="35 46 0" material="glass"/>
    <box size="66 3 110" pos="-6 64 0" material="trim"/>
    <box size="8 20 120" pos="42 12 0" material="steel_dark"/>
    <warn-light pos="-20 65 46" material="flame"/>
    <warn-light pos="-20 65 -46" material="flame"/>
  </group>
  <!-- hopper -->
  <group pos="-42 66 0">
    <box size="196 76 156" pos="0 38 0" material="paint_plain" tint="1"><taper amount="0.12"/></box>
    <box size="8 80 172" pos="-60 40 0" material="trim"><array count="4" translation="40 0 0"/></box>
    <box size="224 8 178" pos="0 70 0" material="emblem_gold"/>
    <box size="208 5 162" pos="0 76 0" material="steel_dark"/>
    <sphere radius="34" rings="4" slices="6" scale="1.3 0.55 1" pos="-30 82 -30" material="ore"/>
    <sphere radius="30" rings="4" slices="6" scale="1.2 0.6 1" rot="0 40 0" pos="30 82 26" material="ore"/>
    <sphere radius="26" rings="4" slices="5" scale="1 0.7 1" pos="-50 84 34" material="ore"/>
    <sphere radius="22" rings="4" slices="5" scale="1 0.7 1" rot="0 25 0" pos="50 83 -36" material="ore"/>
    <sphere radius="24" rings="3" slices="5" pos="0 88 0" material="ore"/>
    <ladder height="70" pos="-104 10 40" rot="0 90 0"/>
  </group>
  <!-- exhaust stacks behind the cab -->
  <cylinder radius="5" height="80" sides="8" pos="72 120 62" material="steel_dark"/>
  <cylinder radius="5" height="80" sides="8" pos="72 120 -62" material="steel_dark"/>
  <!-- pickup drum -->
  <beam ax="140" ay="58" az="72" bx="176" by="36" bz="72" width="10" depth="12" material="gunmetal"/>
  <beam ax="140" ay="58" az="-72" bx="176" by="36" bz="-72" width="10" depth="12" material="gunmetal"/>
  <cylinder radius="26" height="152" sides="10" rot="90 0 0" pos="178 30 0" material="steel"/>
  <group pos="178 30 0" rot="0 0 {45*move}">
    <box size="12 64 8" pos="0 0 -60" material="hazard"><array count="6" translation="0 0 24"/></box>
    <box size="64 12 8" pos="0 0 -48" material="hazard"><array count="5" translation="0 0 24"/></box>
  </group>
</prefab>
