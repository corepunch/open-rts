<?xml version="1.0" encoding="UTF-8"?>
<!-- Ore Harvester. Length 300 cm on X, width 160 cm on Z, origin at the chassis centre on the
     ground, cab and scoop face +X. Six-wheel truck with a forward cab, a tapered ore hopper
     heaped with ore, and a toothed pickup drum. Team colour on the cab roof and hopper band. -->
<prefab up="y" front="+x">
  <include src="../../utilities.xml"/>
  <group pos="0 30 0">
    <cylinder radius="30" height="30" sides="16" rot="90 0 0" pos="90 0 66" material="rubber"><array count="3" translation="-95 0 0"/></cylinder>
    <cylinder radius="30" height="30" sides="16" rot="90 0 0" pos="90 0 -66" material="rubber"><array count="3" translation="-95 0 0"/></cylinder>
    <cylinder radius="14" height="32" rot="90 0 0" pos="90 0 66" material="steel"><array count="3" translation="-95 0 0"/></cylinder>
    <cylinder radius="14" height="32" rot="90 0 0" pos="90 0 -66" material="steel"><array count="3" translation="-95 0 0"/></cylinder>
  </group>
  <soft-box width="290" height="26" depth="104" radius="8" bevel="3" pos="0 52 0" material="steel_dark"/>
  <!-- cab, y 65..140 -->
  <soft-box width="70" height="75" depth="140" radius="12" bevel="4" pos="110 102 0" material="armor"/>
  <box size="3 26 120" pos="145.5 116 0" material="glass"/>
  <soft-box width="74" height="8" depth="144" radius="12" bevel="3" pos="110 142 0" material="team" tint="1"/>
  <sphere radius="7" pos="96 150 40" material="flame" unlit="1" castShadow="0"/>
  <!-- hopper, wider at the top -->
  <box size="190 80 150" pos="-40 105 0" material="rust">
    <taper amount="0.14"/>
  </box>
  <box size="218 10 172" pos="-40 128 0" material="team" tint="1"/>
  <!-- ore heap: a low dark bed and faceted lumps -->
  <box size="196 6 154" pos="-40 140 0" material="rust"/>
  <sphere radius="34" rings="4" slices="6" scale="1.3 0.55 1" pos="-70 146 -28" material="ore"/>
  <sphere radius="30" rings="4" slices="6" scale="1.2 0.6 1" rot="0 40 0" pos="-10 146 26" material="ore"/>
  <sphere radius="26" rings="4" slices="5" scale="1 0.7 1" pos="-90 148 34" material="ore"/>
  <sphere radius="22" rings="4" slices="5" scale="1 0.7 1" rot="0 25 0" pos="10 147 -36" material="ore"/>
  <sphere radius="20" rings="3" slices="5" pos="-40 152 0" material="ore"/>
  <!-- pickup drum with teeth -->
  <beam ax="120" ay="60" az="70" bx="166" by="38" bz="70" width="10" depth="12" material="steel_dark"/>
  <beam ax="120" ay="60" az="-70" bx="166" by="38" bz="-70" width="10" depth="12" material="steel_dark"/>
  <cylinder radius="26" height="150" sides="12" rot="90 0 0" pos="168 32 0" material="steel"/>
  <box size="12 64 8" pos="168 32 -60" material="hazard"><array count="6" translation="0 0 24"/></box>
  <box size="64 12 8" pos="168 32 -48" material="hazard"><array count="5" translation="0 0 24"/></box>
</prefab>
