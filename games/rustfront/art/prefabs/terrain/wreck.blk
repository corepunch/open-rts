<?xml version="1.0" encoding="UTF-8"?>
<!-- Battlefield scrap, one map cell: 200 x 200 cm centred on the origin, lying on y = 0, north
     (the screen's top) is -Z. The knob v (0..2) picks the pile: a burnt-out hull with its
     wheel, a heap of plates and drums, a fallen gantry. Rust and soot, no team colour.
     terrain.py renders it over the sand texture with its shadow. Low (under 70 cm) and in
     the south of the cell, so the tile holds it at game scale. -->
<prefab up="y" front="+z">
  <let name="v" value="0"/>
  <material id="terrain_burnt" color="0.20 0.18 0.16" shininess="6"><map type="noise" size="14" octaves="4" from="0.70 0.70 0.70" to="1.20 1.10 1.00"/></material>
  <material id="terrain_scrap" color="0.50 0.30 0.18" shininess="8"><map type="noise" size="12" octaves="4" from="0.60 0.58 0.55" to="1.15 1.06 0.98"/></material>

  <!-- v 0: a burnt-out hull, nose down, and its wheel -->
  <group pos="0 {v == 0 ? 0 : -400} 8" scale="1.3 1.2 1.3">
    <box size="132 40 78" pos="-8 18 0" rot="6 -18 -7" material="terrain_burnt">
      <taper amount="-0.25" axis="y"/>
      <bevel amount="4"/>
    </box>
    <box size="54 18 54" pos="-14 44 -4" rot="0 12 4" material="terrain_scrap"><bevel amount="3"/></box>
    <box size="70 4 6" pos="40 46 -6" rot="0 -10 -10" material="steel_dark"/>
    <cylinder radius="24" height="14" tube="10" sides="12" pos="70 7 46" material="rubber"/>
  </group>

  <!-- v 1: plates and drums -->
  <group pos="0 {v == 1 ? 0 : -400} 6" scale="1.3 1.2 1.3">
    <box size="90 4 62" pos="-24 6 8" rot="8 30 6" material="terrain_scrap"/>
    <box size="70 4 50" pos="30 4 -10" rot="-6 -22 10" material="terrain_burnt"/>
    <cylinder radius="18" height="56" sides="12" pos="44 18 40" rot="90 0 30" material="terrain_scrap"/>
    <cylinder radius="18" height="56" sides="12" pos="-50 28 46" material="rust"/>
  </group>

  <!-- v 2: a fallen gantry -->
  <group pos="0 {v == 2 ? 0 : -400} 10" scale="1.15 1.2 1.3">
    <box size="170 10 10" pos="0 6 -16" rot="0 14 0" material="terrain_scrap"/>
    <box size="170 10 10" pos="0 6 22" rot="0 14 0" material="terrain_scrap"/>
    <box size="8 8 44" pos="-64 6 18" rot="0 14 0" material="terrain_burnt"><array count="6" translation="26 0 0"/></box>
    <box size="40 24 40" pos="64 12 30" rot="0 -20 0" material="terrain_burnt"><bevel amount="3"/></box>
  </group>
</prefab>
