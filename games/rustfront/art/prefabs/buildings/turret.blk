<?xml version="1.0" encoding="UTF-8"?>
<!-- Gun Turret. Footprint 1x1 cell (200 x 200 cm), origin at pad centre on the ground,
     barrels face +Z. A battered octagonal bunker with a faceted gunmetal head (a tapered
     top-view wedge), twin cannons with sleeves, a sensor and a sandbag lip. Team colour on
     the head roof. -->
<prefab up="y" front="+z">
  <include src="../../utilities.xml"/>
  <include src="../../kit.xml"/>
  <prism radius="98" height="16" sides="8" rot="0 22.5 0" pos="0 8 0" material="pad_dark"/>
  <prism radius="82" height="54" sides="8" rot="0 22.5 0" pos="0 43 0" material="concrete"><taper amount="-0.2"/></prism>
  <prism radius="66" height="4" sides="8" rot="0 22.5 0" pos="0 72 0" material="steel_dark"/>
  <cylinder radius="50" height="8" sides="16" pos="0 78 0" material="steel_dark"/>
  <!-- head: wedge pointing +Z -->
  <group pos="0 98 0" rot="0 -90 0">
    <shape closed="1" v="54 0 30 40 -36 44 -52 26 -52 -26 -36 -44 30 -40" rot="90 0 0" material="gunmetal">
      <extrude amount="32"/><bevel amount="2" bevelSegments="1"/>
      <taper center="0 0 0" amount="0.36" axis="z"/>
    </shape>
    <shape closed="1" v="34 0 18 26 -26 30 -38 18 -38 -18 -26 -30 18 -26" rot="90 0 0" pos="0 16.6 0" material="team" tint="1">
      <extrude amount="1.2"/>
    </shape>
    <box size="18 22 52" pos="52 0 0" material="steel_dark"/>
    <cylinder radius="5" height="90" sides="10" rot="0 0 -90" pos="104 0 14" material="steel_dark"/>
    <cylinder radius="5" height="90" sides="10" rot="0 0 -90" pos="104 0 -14" material="steel_dark"/>
    <cylinder radius="8" height="22" sides="10" rot="0 0 -90" pos="70 0 14" material="gunmetal"/>
    <cylinder radius="8" height="22" sides="10" rot="0 0 -90" pos="70 0 -14" material="gunmetal"/>
    <box size="12 11 11" pos="148 0 14" material="steel_dark"/>
    <box size="12 11 11" pos="148 0 -14" material="steel_dark"/>
    <box size="14 10 14" pos="-20 20 26" material="steel_dark"/>
    <sphere radius="3" rings="4" slices="6" pos="-13 21 26" material="glow" unlit="1" castShadow="0"/>
    <cylinder radius="1" height="40" sides="5" pos="-30 36 -24" material="steel_dark"/>
  </group>
  <sandbags count="3" pos="0 20 92"/>
</prefab>
