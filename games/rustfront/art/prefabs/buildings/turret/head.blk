<?xml version="1.0" encoding="UTF-8"?>
<!-- Gun Turret head. Origin on the slewing axis at mount height; barrels face +X (the assembled building turns it to +Z). A painted wedge with a dark roof plate, white sleeves and twin cannons. -->
<prefab up="y" front="+x">
  <include src="../../../utilities.xml"/>
  <include src="../../../kit.xml"/>
  <!-- Animation knob, set per frame by art/sprites.py: fire 1 is the shot (flash, full recoil),
       fire 2 the barrel running back out. -->
  <let name="fire" value="0"/>
  <let name="kick" value="fire == 1 ? 10 : (fire == 2 ? 4 : 0)"/>

  <shape closed="1" v="54 0 30 40 -36 44 -52 26 -52 -26 -36 -44 30 -40" rot="90 0 0" pos="0 2 0" material="team" tint="1">
    <fillet radius="8" segments="2"/><extrude amount="36"/><bevel amount="6" bevelSegments="2"/>
    <taper center="0 0 0" amount="0.3" axis="z"/>
  </shape>
  <shape closed="1" v="30 0 16 22 -24 26 -34 16 -34 -16 -24 -26 16 -22" rot="90 0 0" pos="0 20.6 0" material="trim">
    <extrude amount="1.6"/>
  </shape>
  <box size="18 24 54" pos="52 0 0" material="trim"/>
  <cylinder radius="5.5" height="90" sides="10" rot="0 0 -90" pos="{104-kick} 0 14" material="steel_dark"/>
  <cylinder radius="5.5" height="90" sides="10" rot="0 0 -90" pos="{104-kick} 0 -14" material="steel_dark"/>
  <cylinder radius="9" height="24" sides="10" rot="0 0 -90" pos="70 0 14" material="trim_light"/>
  <cylinder radius="9" height="24" sides="10" rot="0 0 -90" pos="70 0 -14" material="trim_light"/>
  <box size="12 12 12" pos="{148-kick} 0 14" material="steel_dark"/>
  <box size="12 12 12" pos="{148-kick} 0 -14" material="steel_dark"/>
  <muzzle-flash pos="{155-kick} 0 14" on="{fire == 1}"/>
  <muzzle-flash pos="{155-kick} 0 -14" on="{fire == 1}"/>
  <sphere radius="5" rings="4" slices="6" pos="-22 23 0" material="glow" unlit="1" castShadow="0"/>
</prefab>
