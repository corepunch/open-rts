<?xml version="1.0" encoding="UTF-8"?>
<!-- Gun Turret head. Origin on the slewing axis at mount height; barrels face +X (the assembled building turns it to +Z). A faceted gunmetal wedge with twin cannons. Team colour on the roof. -->
<prefab up="y" front="+x">
  <include src="../../../utilities.xml"/>
  <include src="../../../kit.xml"/>
  <!-- Animation knob, set per frame by art/sprites.py: fire 1 is the shot (flash, full recoil),
       fire 2 the barrel running back out. -->
  <let name="fire" value="0"/>
  <let name="kick" value="fire == 1 ? 10 : (fire == 2 ? 4 : 0)"/>

    <shape closed="1" v="54 0 30 40 -36 44 -52 26 -52 -26 -36 -44 30 -40" rot="90 0 0" material="gunmetal">
      <extrude amount="32"/><bevel amount="2" bevelSegments="1"/>
      <taper center="0 0 0" amount="0.36" axis="z"/>
    </shape>
    <shape closed="1" v="34 0 18 26 -26 30 -38 18 -38 -18 -26 -30 18 -26" rot="90 0 0" pos="0 16.6 0" material="team" tint="1">
      <extrude amount="1.2"/>
    </shape>
    <box size="18 22 52" pos="52 0 0" material="steel_dark"/>
    <cylinder radius="5" height="90" sides="10" rot="0 0 -90" pos="{104-kick} 0 14" material="steel_dark"/>
    <cylinder radius="5" height="90" sides="10" rot="0 0 -90" pos="{104-kick} 0 -14" material="steel_dark"/>
    <cylinder radius="8" height="22" sides="10" rot="0 0 -90" pos="70 0 14" material="gunmetal"/>
    <cylinder radius="8" height="22" sides="10" rot="0 0 -90" pos="70 0 -14" material="gunmetal"/>
    <box size="12 11 11" pos="{148-kick} 0 14" material="steel_dark"/>
    <box size="12 11 11" pos="{148-kick} 0 -14" material="steel_dark"/>
    <muzzle-flash pos="{155-kick} 0 14" on="{fire == 1}"/>
    <muzzle-flash pos="{155-kick} 0 -14" on="{fire == 1}"/>
    <box size="14 10 14" pos="-20 20 26" material="steel_dark"/>
    <sphere radius="3" rings="4" slices="6" pos="-13 21 26" material="glow" unlit="1" castShadow="0"/>
    <cylinder radius="1" height="40" sides="5" pos="-30 36 -24" material="steel_dark"/>
  </prefab>
