<?xml version="1.0" encoding="UTF-8"?>
<!-- Sentry Post head. Origin on the slewing axis at mount height (90 cm above the ground on
     sentry/base); guns face +X (the assembled post turns it to +Z). A compact painted gun box on a
     dark cradle behind a white shield plate, twin machine guns with an ammo box on each side, and a
     small radar dish on a mast at the back. -->
<prefab up="y" front="+x">
  <include src="../../../utilities.xml"/>
  <include src="../../../kit.xml"/>
  <!-- Animation knob, set per frame by art/sprites.py: fire 1 is the shot (flash, full recoil),
       fire 2 the barrels running back out. -->
  <let name="fire" value="0"/>
  <let name="kick" value="fire == 1 ? 6 : (fire == 2 ? 2 : 0)"/>

  <group scale="1.3 1.3 1.3">
    <!-- cradle and gun box -->
    <cylinder radius="26" height="8" sides="14" pos="0 -10 0" material="trim"/>
    <shape closed="1" v="34 0 18 22 -24 26 -36 16 -36 -16 -24 -26 18 -22" rot="90 0 0" pos="0 4 0" material="team" tint="1">
      <extrude amount="22"/><bevel amount="3" bevelSegments="2"/>
      <taper center="0 0 0" amount="0.3" axis="z"/>
    </shape>
    <shape closed="1" v="18 0 8 13 -16 15 -24 9 -24 -9 -16 -15 8 -13" rot="90 0 0" pos="0 15.4 0" material="trim">
      <extrude amount="1.2"/>
    </shape>
    <!-- shield plate, leaning back, with a sight slot -->
    <box size="5 40 74" rot="0 0 -16" pos="32 10 0" material="trim_light"/>
    <box size="5.4 6 20" rot="0 0 -16" pos="34 20 0" material="trim"/>
    <!-- ammo boxes -->
    <box size="22 18 12" pos="-4 2 31" material="armor"/>
    <box size="22 18 12" pos="-4 2 -31" material="armor"/>
    <box size="22 3 12" pos="-4 12.5 31" material="hazard"/>
    <box size="22 3 12" pos="-4 12.5 -31" material="hazard"/>
    <!-- twin machine guns through the shield -->
    <box size="30 10 10" pos="24 0 12" material="gunmetal"/>
    <box size="30 10 10" pos="24 0 -12" material="gunmetal"/>
    <cylinder radius="3.4" height="40" sides="8" rot="0 0 -90" pos="{54-kick} 0 12" material="steel_dark"/>
    <cylinder radius="3.4" height="40" sides="8" rot="0 0 -90" pos="{54-kick} 0 -12" material="steel_dark"/>
    <cylinder radius="2" height="22" sides="6" rot="0 0 -90" pos="{84-kick} 0 12" material="steel_dark"/>
    <cylinder radius="2" height="22" sides="6" rot="0 0 -90" pos="{84-kick} 0 -12" material="steel_dark"/>
    <muzzle-flash pos="{95-kick} 0 12" scale="0.7 0.7 0.7" on="{fire == 1}"/>
    <muzzle-flash pos="{95-kick} 0 -12" scale="0.7 0.7 0.7" on="{fire == 1}"/>
    <!-- radar dish on a mast at the back -->
    <cylinder radius="2.5" height="26" sides="6" pos="-26 26 0" material="steel_dark"/>
    <group pos="-26 40 0" rot="0 0 24">
      <cone radius="17" radiusTop="4" height="6" sides="14" rot="0 0 90" pos="-2 0 0" material="trim_light"/>
      <cylinder radius="1.5" height="12" sides="5" rot="0 0 -90" pos="4 0 0" material="steel_dark"/>
    </group>
    <sphere radius="3" rings="4" slices="6" pos="-14 17 14" material="glow" unlit="1" castShadow="0"/>
  </group>
</prefab>
