<?xml version="1.0" encoding="UTF-8"?>
<!-- Barracks. Footprint 2x2 cells (400 x 400 cm), origin at pad centre on the ground, door
     faces +Z. A corrugated quonset hut with sandbag emplacements and a team flag. -->
<prefab up="y" front="+z">
  <include src="../../utilities.xml"/>
  <slab width="400" height="20" depth="400" pos="0 10 0" material="pad"/>

  <!-- hut: a round-topped arch extruded 300 cm along Z -->
  <!-- an <arch> is centred on its pos: height 150 spans y 20..170, the round top is radius 125 -->
  <arch width="250" height="150" depth="300" segments="20" pos="-20 95 -30" material="steel"/>
  <arch width="258" height="154" depth="12" tube="7" segments="20" pos="-20 97 -150" material="team" tint="1"><array count="3" translation="0 0 120"/></arch>
  <!-- door end -->
  <box size="80 100 6" pos="-20 70 123" material="steel_dark"/>
  <soft-box width="110" height="8" depth="36" radius="3" bevel="2" pos="-20 132 136" material="hazard"/>
  <sphere radius="4" pos="-20 122 128" material="lamp" unlit="1" castShadow="0"/>
  <!-- roof vents -->
  <cylinder radius="10" height="24" pos="-20 175 -90" material="steel_dark"/>
  <cylinder radius="10" height="24" pos="-20 175 30" material="steel_dark"/>

  <!-- sandbag walls, front right and back right -->
  <group pos="150 0 150">
    <capsule radius="12" height="26" rot="0 0 90" pos="-60 32 0" material="armor"><array count="3" translation="0 -50 0"/></capsule>
    <capsule radius="12" height="26" rot="0 0 90" pos="-35 54 0" material="armor_dark"><array count="2" translation="0 -50 0"/></capsule>
    <capsule radius="12" height="26" rot="0 90 90" pos="40 32 -50" material="armor"><array count="2" translation="0 -50 0"/></capsule>
  </group>
  <!-- flag -->
  <cylinder radius="3" height="210" pos="150 125 -150" material="steel"/>
  <box size="64 38 2" pos="184 208 -150" material="team" tint="1"/>
  <!-- crates -->
  <box size="40 36 40" pos="150 38 -40" material="rust"/>
  <box size="30 28 30" pos="152 70 -42" rot="0 20 0" material="armor_dark"/>
</prefab>
