<?xml version="1.0" encoding="UTF-8"?>
<!-- Power Plant. Footprint 2x2 cells (400 x 400 cm), origin at pad centre on the ground,
     turbine hall faces +Z. Two cooling towers behind a battered turbine hall with a gunmetal
     gable roof and a glowing reactor strip, feed pipes, and a fenced transformer yard. -->
<prefab up="y" front="+z">
  <include src="../../utilities.xml"/>
  <include src="../../kit.xml"/>
  <!-- Animation knobs, set per frame by art/sprites.py. -->
  <let name="pulse" value="0"/>
  <let name="blink" value="1"/>
  <shape id="rf_cooling_tower" closed="0" v="84 0 74 50 62 110 58 150 62 190 64 200 56 200"/>
  <slab width="400" height="20" depth="400" pos="0 10 0" material="pad"/>

  <lathe shape="rf_cooling_tower" segments="24" pos="-96 20 -86" material="concrete"/>
  <lathe shape="rf_cooling_tower" segments="24" pos="92 20 -96" scale="0.85 0.8 0.85" material="concrete"/>
  <cylinder radius="64" height="10" tube="5" sides="24" pos="-96 212 -86" material="team" tint="1"/>
  <cylinder radius="55" height="9" tube="5" sides="24" pos="92 177 -96" material="team" tint="1"/>
  <cylinder radius="55" height="2" sides="24" pos="-96 220.5 -86" material="steel_dark"/>
  <cylinder radius="47" height="2" sides="24" pos="92 181 -96" material="steel_dark"/>
  <ladder height="150" pos="-96 20 -10"/>

  <!-- turbine hall: y 20..90, x -150..110, z 58..178 -->
  <bunker width="260" height="70" depth="120" lean="-0.1" pos="-20 55 118" material="concrete_dark"/>
  <group pos="-20 90 118" rot="0 90 0">
    <shape closed="0" v="-64 0 0 26 64 0" material="roofing"><extrude amount="270"/><shell amount="5"/></shape>
  </group>
  <box size="200 {12-6*pulse} 3" rot="-4.9 0 0" pos="-30 50 176.6" material="glow" unlit="1" castShadow="0"/>
  <box size="3 {12-6*pulse} 80" rot="0 0 4.9" pos="109.6 50 118" material="glow" unlit="1" castShadow="0"/>
  <box size="44 54 5" pos="-130 47 178" material="gunmetal"/>
  <box size="50 5 6" pos="-130 77 179" material="hazard"/>
  <warn-light on="{blink}" pos="-150 118 118"/>
  <warn-light on="{blink}" pos="110 118 118"/>
  <cylinder radius="12" height="70" sides="10" pos="60 135 100" material="steel"/>
  <cylinder radius="13" height="10" sides="10" pos="60 165 100" material="hazard"/>

  <!-- feed pipes -->
  <tube ax="-96" ay="70" az="-16" bx="-96" by="70" bz="62" r0="10" material="steel_dark"/>
  <tube ax="92" ay="62" az="-38" bx="92" by="62" bz="40" r0="9" material="steel_dark"/>
  <tube ax="92" ay="62" az="40" bx="60" by="62" bz="62" r0="9" material="steel_dark"/>

  <!-- transformer yard, front right -->
  <group pos="158 20 120">
    <box size="74 2 120" pos="0 1 0" material="pad_dark"/>
    <box size="32 30 36" pos="0 17 -30" material="gunmetal"/>
    <box size="32 30 36" pos="0 17 30" material="gunmetal"/>
    <cylinder radius="3" height="16" sides="6" pos="-8 40 -30" material="steel"><array count="3" translation="8 0 0"/></cylinder>
    <cylinder radius="3" height="16" sides="6" pos="-8 40 30" material="steel"><array count="3" translation="8 0 0"/></cylinder>
    <railing length="120" height="20" pos="37 2 0" rot="0 90 0" material="steel_dark"/>
    <railing length="74" height="20" pos="0 2 60" material="steel_dark"/>
  </group>
</prefab>
