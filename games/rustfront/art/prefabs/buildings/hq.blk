<?xml version="1.0" encoding="UTF-8"?>
<!-- Command Center. Footprint 3x3 cells (600 x 600 cm), origin at pad centre on the ground,
     entrance faces +Z. A battered concrete bunker with a team-coloured parapet, a second
     command level with raked windows, a radar dish, a lattice comms mast, a rooftop helipad,
     an armoured entrance vestibule and floodlights on the pad. -->
<prefab up="y" front="+z">
  <include src="../../utilities.xml"/>
  <include src="../../kit.xml"/>
  <slab width="600" height="20" depth="600" pos="0 10 0" material="pad"/>

  <!-- lower bunker: y 20..130, base x ±240 z -240..200, top 12 % smaller -->
  <bunker width="480" height="110" depth="440" pos="0 75 -20" material="concrete"/>
  <box size="418 4 383" pos="0 132 -20" material="roofing"/>
  <box size="422 8 6" pos="0 138 170.5" material="team" tint="1"/>
  <box size="422 8 6" pos="0 138 -210.5" material="team" tint="1"/>
  <box size="6 8 375" pos="208 138 -20" material="team" tint="1"/>
  <box size="6 8 375" pos="-208 138 -20" material="team" tint="1"/>
  <!-- raked window bands on the two seen walls -->
  <box size="320 14 4" rot="-13.5 0 0" pos="-60 90 183.5" material="glass"/>
  <box size="4 14 320" rot="0 0 14.8" pos="222 90 -30" material="glass"/>

  <!-- command level: y 134..224 -->
  <bunker width="250" height="90" depth="220" lean="-0.18" pos="-50 179 -70" material="concrete_dark"/>
  <box size="170 14 4" rot="-12.4 0 0" pos="-50 205 25" material="glass"/>
  <box size="4 14 150" rot="0 0 14.2" pos="61 205 -70" material="glass"/>
  <box size="200 3 174" pos="-50 225.5 -70" material="roofing"/>
  <vent width="44" depth="40" height="14" pos="0 227 -120"/>
  <warn-light pos="20 227 0"/>

  <!-- radar dish on a yoke -->
  <cylinder radius="9" height="22" sides="8" pos="-110 238 -100" material="gunmetal"/>
  <group pos="-110 252 -100" rot="38 30 0">
    <surface segments="20 5" twoSided="1" material="steel" x="52*v*cos(u*2*pi)" y="16*v*v" z="-52*v*sin(u*2*pi)"/>
    <cylinder radius="1.5" height="34" sides="6" pos="0 17 0" material="steel_dark"/>
    <box size="8 8 8" pos="0 36 0" material="steel_dark"/>
  </group>

  <!-- comms mast on the lower deck, back right -->
  <prism radius="17" height="190" sides="3" pos="160 229 -175" material="steel"><taper amount="-0.75"/></prism>
  <torus majorRadius="11" minorRadius="1.5" majorSegments="8" minorSegments="4" pos="160 200 -175" material="steel"/>
  <torus majorRadius="7" minorRadius="1.5" majorSegments="8" minorSegments="4" pos="160 260 -175" material="steel"/>
  <warn-light pos="160 323 -175"/>

  <!-- helipad on the lower deck, front left -->
  <cylinder radius="46" height="2" sides="20" pos="-130 135 110" material="pad_dark"/>
  <cylinder radius="49" height="2.4" tube="4" sides="20" pos="-130 135.2 110" material="team" tint="1"/>
  <box size="7 1 40" pos="-143 136.4 110" material="lamp" unlit="1" castShadow="0"/>
  <box size="7 1 40" pos="-117 136.4 110" material="lamp" unlit="1" castShadow="0"/>
  <box size="20 1 7" pos="-130 136.4 110" material="lamp" unlit="1" castShadow="0"/>
  <!-- lower deck plant, right -->
  <vent width="50" depth="50" height="18" pos="150 134 70"/>
  <vent width="50" depth="40" height="18" pos="150 134 -20"/>
  <tube ax="125" ay="146" az="70" bx="85" by="146" bz="70" r0="5" material="steel_dark"/>

  <!-- armoured entrance vestibule, front right -->
  <bunker width="150" height="84" depth="56" lean="-0.08" pos="90 62 214" material="concrete_dark"/>
  <box size="96 60 4" pos="90 50 242" material="gunmetal"/>
  <box size="2 56 2" pos="90 50 245" material="steel_dark"/>
  <box size="116 8 6" pos="90 88 241" material="hazard"/>
  <warn-light pos="30 104 225"/>
  <warn-light pos="150 104 225"/>
  <box size="110 3 50" pos="90 21.5 268" material="pad_dark"/>
  <!-- floodlights on the pad -->
  <floodlight pos="-270 20 270" rot="0 -45 0"/>
  <floodlight pos="270 20 270" rot="0 -135 0"/>
</prefab>
