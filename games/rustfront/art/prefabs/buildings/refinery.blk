<?xml version="1.0" encoding="UTF-8"?>
<!-- Ore Refinery. Footprint 3x2 cells (600 wide on X, 400 deep on Z), origin at pad centre
     on the ground, unloading dock faces +Z. Three domed silos, an octagonal processing tower
     fed by a conveyor from the dock, and a flare stack. Team colour on silo bands. -->
<prefab up="y" front="+z">
  <include src="../../utilities.xml"/>
  <slab width="600" height="20" depth="400" pos="0 10 0" material="pad"/>

  <!-- silos, y 20..160 plus domes -->
  <group pos="-210 0 -100">
    <cylinder radius="54" height="140" sides="24" pos="0 90 0" material="concrete"/>
    <sphere radius="54" scale="1 0.4 1" pos="0 160 0" material="concrete"/>
    <cylinder radius="55.5" height="14" sides="24" pos="0 128 0" material="team" tint="1"/>
  </group>
  <group pos="-90 0 -100">
    <cylinder radius="54" height="140" sides="24" pos="0 90 0" material="concrete"/>
    <sphere radius="54" scale="1 0.4 1" pos="0 160 0" material="concrete"/>
    <cylinder radius="55.5" height="14" sides="24" pos="0 128 0" material="team" tint="1"/>
  </group>
  <group pos="-150 0 40">
    <cylinder radius="44" height="100" sides="24" pos="0 70 0" material="concrete_dark"/>
    <sphere radius="44" scale="1 0.4 1" pos="0 120 0" material="concrete_dark"/>
  </group>
  <tube ax="-36" ay="110" az="-100" bx="38" by="110" bz="-90" r0="9" material="steel_dark"/>
  <tube ax="-156" ay="140" az="-100" bx="-144" by="140" bz="-100" r0="9" material="steel_dark"/>

  <!-- processing tower, y 20..280 -->
  <prism radius="62" height="210" sides="8" pos="95 125 -90" material="concrete"/>
  <prism radius="64" height="12" sides="8" pos="95 200 -90" material="hazard"/>
  <cone radius="64" radiusTop="22" height="44" sides="8" smooth="0" pos="95 252 -90" material="steel_dark"/>
  <cylinder radius="12" height="34" pos="95 291 -90" material="steel_dark"/>

  <!-- unloading dock and conveyor up into the tower -->
  <box size="200 4 130" pos="10 22 115" material="steel_dark"/>
  <box size="200 6 12" pos="10 23 44" material="hazard"/>
  <box size="200 6 12" pos="10 23 186" material="hazard"/>
  <beam ax="40" ay="28" az="90" bx="92" by="170" bz="-26" width="44" depth="12" material="rust"/>
  <beam ax="40" ay="20" az="90" bx="40" by="40" bz="90" width="40" depth="12" material="steel_dark"/>

  <!-- flare stack -->
  <cylinder radius="10" height="260" pos="225 150 -150" material="steel"/>
  <cylinder radius="11" height="14" pos="225 270 -150" material="hazard"/>
  <cone radius="13" radiusTop="0" height="36" pos="225 298 -150" material="flame" unlit="1" castShadow="0"/>
  <light pos="225 300 -150" color="1 0.6 0.25" intensity="0.6" radius="200" castShadows="0"/>

  <!-- control booth -->
  <soft-box width="110" height="70" depth="80" radius="10" bevel="3" pos="215 55 115" material="concrete"/>
  <box size="80 18 3" pos="210 70 156" material="glass"/>
</prefab>
