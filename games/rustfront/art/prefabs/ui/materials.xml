<?xml version="1.0" encoding="UTF-8"?>
<!-- The interface's metals (art/ui.py): brushed steel faces, dark bezels, bolts and lamps.
     Brushing is noise stretched along x. Nine-slices stretch their middles, so a surface there
     takes only fine horizontal brushing: a round feature would show the stretch. A library cannot carry materials, so art/ui.py puts
     these into the scene that places the ui prefabs. -->
<library>
  <material id="ui_bezel"   color="0.10 0.11 0.12" shininess="30" metallic="0.3"/>
  <material id="ui_plate"   color="0.21 0.22 0.22" shininess="30" metallic="0.35">
    <map type="noise" size="90 1.6 1" octaves="3" from="0.82 0.82 0.84" to="1.12 1.12 1.12"/>
  </material>
  <material id="ui_rim"     color="0.36 0.37 0.36" shininess="45" metallic="0.4">
    <map type="noise" size="60 1.2 1" octaves="3" from="0.86 0.86 0.88" to="1.1 1.1 1.1"/>
  </material>
  <material id="ui_face"    color="0.46 0.47 0.46" shininess="55" metallic="0.45">
    <map type="noise" size="70 1.2 1" octaves="3" from="0.84 0.84 0.86" to="1.12 1.12 1.12"/>
  </material>
  <material id="ui_face_lit" color="0.60 0.58 0.52" shininess="60" metallic="0.45">
    <map type="noise" size="70 1.2 1" octaves="3" from="0.86 0.86 0.86" to="1.12 1.10 1.06"/>
  </material>
  <material id="ui_face_down" color="0.36 0.37 0.36" shininess="40" metallic="0.4">
    <map type="noise" size="70 1.2 1" octaves="3" from="0.84 0.84 0.86" to="1.1 1.1 1.1"/>
  </material>
  <material id="ui_face_dull" color="0.19 0.19 0.20" shininess="6" metallic="0.05">
    <map type="noise" size="70 1.2 1" octaves="3" from="0.9 0.9 0.9" to="1.06 1.05 1.03"/>
  </material>
  <material id="ui_bolt"    color="0.66 0.54 0.34" shininess="70" metallic="0.55"/>
  <material id="ui_slot"    color="0.06 0.06 0.07"/>
  <material id="ui_screen"  color="0.035 0.05 0.055" shininess="80" specular="0.6"/>
  <material id="ui_shade"   color="0.05 0.05 0.06"/>
  <material id="ui_light"   color="0.62 0.65 0.66" shininess="40"/>
  <material id="ui_amber"   color="1.0 0.62 0.20"/>
  <material id="ui_amber_dim" color="0.55 0.30 0.10"/>
  <material id="ui_hazard"  color="1 1 1" shininess="8">
    <gradient type="line" start="0 0 0" end="8 8 0" repeat="1" edge="0.5" from="0.10 0.10 0.10" to="0.85 0.62 0.12"/>
  </material>
</library>
