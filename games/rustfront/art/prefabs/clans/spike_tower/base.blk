<?xml version="1.0" encoding="UTF-8"?>
<!-- Spike Tower base without its head (see spike_tower/head.blk). Footprint 1x1 cell (200 x 200
     cm), origin at pad centre on the ground. A scaffold nest: four splayed rusty legs with cross
     braces on a packed-earth pad, a plank deck ringed by spiked scrap plates and a team pennant,
     a swivel post in the middle (the head mounts at y 110), tyres piled round the feet. -->
<prefab up="y" front="+z">
  <include src="../../../utilities.xml"/>
  <include src="../../../kit.xml"/>
  <include src="../clans.xml"/>
  <!-- clans materials: the Scrap Clans' palette, repeated identically in every clans prefab
       (material ids are global, the first definition wins) -->
  <material id="clans_dirt"    color="0.50 0.40 0.28" shininess="3"><map type="noise" size="40" octaves="4" from="0.80 0.80 0.80" to="1.08 1.06 1.02"/></material>
  <material id="clans_rust"    color="0.52 0.27 0.14" shininess="8"><map type="noise" size="18" octaves="4" from="0.62 0.60 0.58" to="1.15 1.08 1.00"/></material>
  <material id="clans_tin"     color="0.58 0.58 0.55" shininess="20" metallic="0.2"><map type="noise" size="34" octaves="4" from="0.78 0.52 0.36" to="1.06 1.04 1.02"/></material>
  <material id="clans_sheet"   color="1 1 1" shininess="14">
    <gradient type="line" start="0 0 0" end="9 0 0" repeat="1" edge="0.45" from="0.62 0.60 0.56" to="0.40 0.37 0.34"/>
  </material>
  <material id="clans_sheet_rust" color="1 1 1" shininess="8">
    <gradient type="line" start="0 0 0" end="9 0 0" repeat="1" edge="0.45" from="0.62 0.36 0.20" to="0.38 0.21 0.12"/>
  </material>
  <material id="clans_paint"   color="0.72 0.22 0.12" shininess="12"><map type="noise" size="16" octaves="4" from="0.58 0.56 0.54" to="1.08 1.06 1.04"/></material>
  <material id="clans_cloth"   color="0.70 0.24 0.14" shininess="2"><map type="noise" size="30" octaves="3" from="0.80 0.80 0.80" to="1.05 1.05 1.05"/></material>
  <material id="clans_canvas"  color="0.60 0.54 0.40" shininess="2"><map type="noise" size="30" octaves="3" from="0.82 0.82 0.82" to="1.05 1.05 1.05"/></material>
  <material id="clans_wood"    color="0.44 0.32 0.20" shininess="4"><map type="bricks" size="200 14 200" mortar="1.2" bond="0" vary="0.15" from="1 1 1" to="0.55 0.55 0.55"/></material>
  <material id="clans_drum"    color="0.74 0.56 0.16" shininess="18"><map type="noise" size="14" octaves="4" from="0.60 0.48 0.40" to="1.06 1.04 1.00"/></material>
  <material id="clans_chain"   color="0.50 0.50 0.48" shininess="20"><map type="checker" size="3" from="0.55 0.55 0.55" to="1.15 1.15 1.15"/></material>
  <material id="clans_bone"    color="0.86 0.82 0.70" shininess="10"/>
  <!-- /clans materials -->
  <!-- Animation knob, set per frame by art/sprites.py: blink 1/0 the warn light. -->
  <let name="blink" value="1"/>
  <chunk width="192" height="16" depth="192" radius="18" bevel="3" lean="0" pos="0 8 0" material="clans_dirt"/>
  <!-- legs and braces -->
  <tube ax="-74" ay="16" az="-74" bx="-62" by="90" bz="-62" r0="7" material="clans_rust"/>
  <tube ax="74" ay="16" az="-74" bx="62" by="90" bz="-62" r0="7" material="clans_rust"/>
  <tube ax="-74" ay="16" az="74" bx="-62" by="90" bz="62" r0="7" material="clans_rust"/>
  <tube ax="74" ay="16" az="74" bx="62" by="90" bz="62" r0="7" material="clans_rust"/>
  <tube ax="-68" ay="30" az="66" bx="56" by="76" bz="56" r0="3.5" material="steel_dark"/>
  <tube ax="-66" ay="30" az="-62" bx="-56" by="76" bz="58" r0="3.5" material="steel_dark"/>
  <tube ax="68" ay="30" az="-66" bx="-56" by="76" bz="-56" r0="3.5" material="steel_dark"/>
  <!-- plank deck and its spiked plate ring -->
  <box size="156 8 156" pos="0 94 0" material="clans_wood"/>
  <box size="160 40 6" rot="-8 0 0" pos="0 116 79" material="clans_paint" tint="1"/>
  <box size="140 34 6" rot="7 0 0" pos="-6 114 -79" material="clans_sheet_rust"/>
  <box size="6 38 150" rot="0 0 -8" pos="79 115 0" material="clans_paint" tint="1"/>
  <box size="6 32 130" rot="0 0 6" pos="-79 113 6" material="clans_sheet_rust"/>
  <group pos="0 135 82" rot="30 0 0">
    <clans-spike radius="4" length="22" pos="-50 0 0"/><clans-spike radius="4" length="26" pos="-18 0 0"/>
    <clans-spike radius="4" length="22" pos="18 0 0"/><clans-spike radius="4" length="26" pos="50 0 0"/>
  </group>
  <group pos="-82 128 0" rot="0 0 30">
    <clans-spike radius="4" length="22" pos="0 0 -40"/><clans-spike radius="4" length="22" pos="0 0 30"/>
  </group>
  <!-- swivel post to the mount at y 110 -->
  <cylinder radius="16" height="12" sides="10" pos="0 104 0" material="steel_dark"/>
  <cylinder radius="24" height="2" sides="12" pos="0 99 0" material="clans_rust"/>
  <clans-flag height="110" size="44" pos="-72 98 -72"/>
  <warn-light on="{blink}" pos="72 98 -72"/>
  <!-- tyres round the feet -->
  <clans-tyre pos="-70 26 74" radius="22" width="18"/>
  <clans-tyre pos="78 26 30" radius="22" width="18"/>
</prefab>
